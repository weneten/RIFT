#!/bin/sh
# Set up this machine as the RIFT server (VPS) in one step, or change its settings later:
#
#   sudo sh deploy/setup-server
#
# It goes through every setting of the server .env, in the order of .env.server.example:
# image, addresses, ports and enrollment, tunnel pools, VPN devices, web panel, terminal UI,
# websites.
# Each question offers a default (Enter takes it, - clears an optional value): what it
# detects on this machine, else the value of the existing .env, else RIFT's default. Groups
# that are rarely changed (ports, address pools, advanced panel settings) are asked only
# after a yes. So running it again with Enter everywhere changes nothing.
# Without a terminal, or with --yes, it takes the defaults. Options set values and skip
# their questions:
#
#   --endpoint NAME_OR_IP   the DNS name or address agents dial (RIFT_PUBLIC_ENDPOINT)
#   --public-ips LIST       addresses on this machine that forwards listen on (RIFT_PUBLIC_IPS)
#   --panel / --no-panel    turn the web panel on (private: over the VPN only) or off
#   --tui / --no-tui        whether `rift` alone opens the terminal UI (RIFT_TUI, default on)
#   --proxy NAME            the reverse proxy for websites (rift add site): traefik, caddy or
#                           npm (Nginx Proxy Manager) are set up in Docker (deploy/setup-proxy);
#                           own uses one that already runs here; none sets up nothing
#   --proxy-kind KIND       with --proxy own: traefik, caddy, nginx (with certbot) or npm
#   --caddy-container NAME  with --proxy-kind caddy: Caddy runs in this Docker container ...
#   --caddy-sites-dir DIR   ... and reads the site files from this host directory
#   --email ADDRESS         the Let's Encrypt address for that proxy
#   --publish-panel DOMAIN  also reach the panel at https://DOMAIN through that proxy
#                           (deploy/publish-panel), read-only unless
#                           --set RIFT_WEBPANEL_CONTROL=public; --publish-panel - unpublishes it
#   --version VERSION       the image: latest or a release such as 1.0.0 (RIFT_VERSION)
#   --set KEY=VALUE         any setting of .env.server.example, e.g. --set RIFT_WG_PORT=51900;
#                           repeatable; an empty VALUE returns it to RIFT's default
#   --yes                   do not ask; take the defaults
#
# Then it prepares the host (deploy/prepare-host), writes config.toml and .env (mode 0600;
# a setting at RIFT's default stays a comment), installs the `rift` command, starts the
# server, waits until it is ready and sets up the proxy and the panel route.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
env_file=$repo_dir/.env
config_file=$repo_dir/config.toml
site_state=/var/lib/rift-site/sites.json

fail() {
  printf 'rift: %s\n' "$*" >&2
  exit 1
}
usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

# RIFT's default of each setting, in the order of .env.server.example.
keys="RIFT_VERSION RIFT_PUBLIC_IPS RIFT_ALLOW_PRIVATE_LISTENERS RIFT_PUBLIC_ENDPOINT
RIFT_WG_PORT RIFT_ENROLLMENT_BIND RIFT_ENROLLMENT
RIFT_IPV4_POOL RIFT_SERVER_IPV4 RIFT_IPV6_POOL RIFT_SERVER_IPV6
RIFT_VPN_POOL RIFT_VPN_POOL6 RIFT_VPN_DNS RIFT_NAMES_PORT RIFT_NAMES_SUFFIX
RIFT_WEBPANEL RIFT_WEBPANEL_PASSWORD RIFT_WEBPANEL_2FA RIFT_WEBPANEL_ACCESS RIFT_WEBPANEL_CONTROL
RIFT_WEBPANEL_PORT RIFT_WEBPANEL_ALLOW RIFT_WEBPANEL_PROXIES RIFT_WEBPANEL_INSECURE RIFT_TUI
RIFT_NPM_EMAIL RIFT_NPM_PASSWORD RIFT_LETSENCRYPT_EMAIL RIFT_REQUEST_CERTIFICATE RIFT_PROXY_SUBNET"
builtin() {
  case $1 in
    RIFT_VERSION) echo latest ;;
    RIFT_ALLOW_PRIVATE_LISTENERS) echo false ;;
    RIFT_WG_PORT) echo 51820 ;;
    RIFT_ENROLLMENT) echo auto ;;
    RIFT_ENROLLMENT_BIND) echo 0.0.0.0:8443 ;;
    RIFT_IPV4_POOL) echo 10.13.0.0/24 ;;
    RIFT_SERVER_IPV4) echo 10.13.0.1 ;;
    RIFT_IPV6_POOL) echo fd88:5249:4654::/64 ;;
    RIFT_SERVER_IPV6) echo fd88:5249:4654::1 ;;
    RIFT_VPN_POOL) echo 10.14.0.0/24 ;;
    RIFT_VPN_POOL6) echo fd88:5249:4655::/64 ;;
    RIFT_VPN_DNS) echo 9.9.9.9,2620:fe::fe ;;
    RIFT_NAMES_PORT) echo 53053 ;;
    RIFT_NAMES_SUFFIX) echo internal ;;
    RIFT_WEBPANEL) echo false ;;
    RIFT_WEBPANEL_ACCESS) echo private ;;
    RIFT_WEBPANEL_PORT) echo 8090 ;;
    RIFT_WEBPANEL_2FA) echo optional ;;
    RIFT_WEBPANEL_CONTROL) echo private ;;
    RIFT_WEBPANEL_INSECURE) echo false ;;
    RIFT_TUI) echo true ;;
    RIFT_PROXY_SUBNET) echo 10.255.13.0/24 ;;
    RIFT_REQUEST_CERTIFICATE) echo true ;;
    *) echo ;;
  esac
}
known_key() {
  for _k in $keys; do
    [ "$1" = "$_k" ] && return 0
  done
  return 1
}

. "$script_dir/env.sh"
. "$script_dir/ask.sh"
. "$script_dir/proxy-net.sh"

# ---------- checks of server settings (the rules of src/config.rs) ----------
control_port=8444
exit_ports_min=51821
exit_ports_max=51899
check_public_ip() {
  is_ip "$1" || return 1
  case $1 in
    0.0.0.0 | 127.* | :: | ::1) why="not a usable public address: $1"; return 1 ;;
  esac
}
check_public_ips() { is_list check_public_ip "$1"; }
check_endpoint() { is_host "$1"; }
# port_user PORT [udp]: the programs other than RIFT that listen on this TCP (or UDP) port,
# comma-separated; empty when the port is free, used by RIFT itself (running again on a set-up
# server) or `ss` is missing.
port_user() {
  command -v ss > /dev/null 2>&1 || return 0
  _flags=-ltnp
  [ "${2-}" != udp ] || _flags=-lunp
  ss "$_flags" "sport = :$1" 2> /dev/null | tail -n +2 | grep -v '"rift"' \
    | sed -n 's/.*users:(("\([^"]*\)".*/\1/p; t; s/.*/an unknown program/p' | sort -u | paste -sd, - || true
}
# free_port PORT: the next TCP port above PORT that nothing listens on and RIFT does not use.
free_port() {
  _p=$1
  while [ "$_p" -lt 65535 ]; do
    _p=$((_p + 1))
    case $_p in "$control_port" | 8443 | 8090) continue ;; esac
    if ! command -v ss > /dev/null 2>&1 || [ -z "$(ss -ltn "sport = :$_p" 2> /dev/null | tail -n +2)" ]; then
      echo "$_p"
      return 0
    fi
  done
}
# A port another program holds: said once, before the question that offers a free one.
port_taken() {
  printf '  %s\n' "Port $1 ($2) is in use by $3. Suggested instead: $4." 2> /dev/null > /dev/tty \
    || printf '%s\n' "rift: port $1 ($2) is in use by $3; using $4 instead."
}

check_wg_port() {
  is_port "$1" || return 1
  if [ "$1" -ge "$exit_ports_min" ] && [ "$1" -le "$exit_ports_max" ]; then
    why="$exit_ports_min-$exit_ports_max are the ports of internet exits; choose another"
    return 1
  fi
}
check_bind() {
  why="ADDRESS:PORT, e.g. 0.0.0.0:8443 or [::]:8443"
  case $1 in
    \[*\]:*) _a=${1%]:*}; _a=${_a#[}; is_ip6 "$_a" || return 1 ;;
    *:*:*) why="ADDRESS:PORT, e.g. 0.0.0.0:8443 or [::]:8443"; return 1 ;;
    *:*) is_ip4 "${1%:*}" || return 1 ;;
    *) return 1 ;;
  esac
  is_port "${1##*:}" || return 1
  [ "${1##*:}" -ne "$control_port" ] || { why="$control_port is the tunnel control port; choose another"; return 1; }
  _u=$(port_user "${1##*:}")
  [ -z "$_u" ] || { why="port ${1##*:} is in use by $_u; choose another, for example ${1%:*}:$(free_port "${1##*:}")"; return 1; }
}
check_enrollment() { one_of "$1" auto always off; }
# The suffix of the agents' names: a domain name in lower case, none that devices resolve
# another way (the rules of vpn::validate_suffix).
check_suffix() {
  why="a domain name in lower case without a leading or final dot, e.g. internal, home.arpa or home.example.net"
  printf '%s\n' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$' || return 1
  case $1 in
    home.arpa | *.home.arpa) return 0 ;;
    local | *.local | localhost | *.localhost | onion | *.onion | alt | *.alt | invalid | *.invalid | example | *.example | arpa | *.arpa)
      why=".local goes to mDNS, .localhost to this machine, .onion to Tor, .alt outside the DNS; .invalid, .example and other .arpa names are reserved. Use internal, home.arpa or a domain of your own"
      return 1
      ;;
  esac
}
# The name server: TCP and UDP from 1024 (the container has no capability for lower ports),
# apart from RIFT's other ports, and free on this host.
check_names_port() {
  is_port "$1" || return 1
  _e=$(get RIFT_ENROLLMENT_BIND)
  why="1024 or higher, apart from the control port $control_port, the enrollment port ${_e##*:}, the WireGuard port $(get RIFT_WG_PORT) and the exit ports $exit_ports_min-$exit_ports_max"
  [ "$1" -ge 1024 ] && [ "$1" -ne "$control_port" ] && [ "$1" -ne "${_e##*:}" ] && [ "$1" -ne "$(get RIFT_WG_PORT)" ] || return 1
  [ "$1" -lt "$exit_ports_min" ] || [ "$1" -gt "$exit_ports_max" ] || return 1
  _u=$( { port_user "$1"; port_user "$1" udp; } | sed '/^$/d' | paste -sd, -)
  [ -z "$_u" ] || { why="port $1 is in use by $_u; choose another, for example $(free_port "$1")"; return 1; }
}
check_pool4() {
  is_net4 "$1" || return 1
  why="the pool must be a private network (10/8, 172.16/12, 192.168/16) from /8 to /29"
  [ "${1#*/}" -ge 8 ] && [ "${1#*/}" -le 29 ] && is_private4 "${1%/*}"
}
check_server4() {
  is_ip4 "$1" || return 1
  _p=$(get RIFT_IPV4_POOL)
  why="must be a host address inside $_p"
  overlap4 "$1" "$_p" || return 1
  _m=$(mask4 "${_p#*/}")
  _net=$(($(ip4_int "${_p%/*}") & _m))
  _n=$(ip4_int "$1")
  [ "$_n" -ne "$_net" ] && [ "$_n" -ne $((_net | (~_m & 4294967295))) ]
}
check_pool6() {
  is_net6 "$1" || return 1
  why="the pool must be a ULA network (fc00::/7, e.g. fd88:5249:4654::/64) of /120 or larger"
  [ "${1#*/}" -le 120 ] || return 1
  case $1 in [fF][cCdD]*) return 0 ;; esac
  return 1
}
check_vpn_pool() {
  check_pool4 "$1" || return 1
  if overlap4 "$1" "$(get RIFT_IPV4_POOL)"; then
    why="overlaps the IPv4 tunnel pool $(get RIFT_IPV4_POOL)"
    return 1
  fi
  _o=$IFS
  IFS=,
  for _ip in $(get RIFT_PUBLIC_IPS); do
    if is_ip4 "$_ip" && overlap4 "$_ip" "$1"; then
      IFS=$_o
      why="contains the public address $_ip"
      return 1
    fi
  done
  IFS=$_o
}
check_vpn_pool6() {
  check_pool6 "$1" || return 1
  [ "${1%/*}" != "$(get RIFT_IPV6_POOL | sed 's,/.*,,')" ] || { why="the same network as the IPv6 tunnel pool"; return 1; }
}
check_dns() {
  is_list is_ip "$1" || return 1
  case ",$1," in
    *,[0-9]*.*.*.*,*) return 0 ;;
  esac
  why="name one IPv4 address at least, for exits without IPv6"
  return 1
}
check_password() {
  [ -n "$1" ] || return 0
  why="at least 12 characters"
  [ "${#1}" -ge 12 ] || return 1
  why="no spaces, quotes, backslash, \$, # or backtick (they break the .env)"
  ! printf '%s' "$1" | grep -q "[[:space:]'\"\\\\\$#\`]"
}
check_2fa() { one_of "$1" optional required; }
check_access() { one_of "$1" private public; }
check_control() { one_of "$1" private public off; }
check_panel_port() {
  is_port "$1" || return 1
  _e=$(get RIFT_ENROLLMENT_BIND)
  why="must differ from the control port $control_port and the enrollment port ${_e##*:}"
  [ "$1" -ne "$control_port" ] && [ "$1" -ne "${_e##*:}" ] || return 1
  # Only a panel that is on needs its port.
  [ "$(get RIFT_WEBPANEL)" = true ] || return 0
  _u=$(port_user "$1")
  [ -z "$_u" ] || { why="port $1 is in use by $_u; choose another, for example $(free_port "$1")"; return 1; }
}
check_addr_list() { is_list is_net_or_ip "$1" empty-ok; }
check_proxy() { one_of "$1" traefik caddy npm own none; }
check_kind() { one_of "$1" traefik caddy nginx npm; }
check_container() {
  why="not a container name: $1"
  printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]*$'
}
check_abs_dir() {
  why="an absolute host directory, e.g. /opt/caddy/rift-sites"
  case $1 in /*) ;; *) return 1 ;; esac
  case /$1/ in */../*) return 1 ;; esac
}
check_npm_password() {
  why="no single quote"
  case $1 in *"'"*) return 1 ;; esac
}
# A value Compose reads literally: single-quoted unless it has only plain characters.
env_quote() {
  if printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._@%+=:,/-]*$'; then
    printf '%s' "$1"
  else
    printf "'%s'" "$1"
  fi
}

proxy=
own_kind=
caddy_container=
has_caddy_container=
caddy_sites_dir=
publish=
has_publish=
assume_yes=
while [ "$#" -gt 0 ]; do
  case $1 in
    --endpoint) [ "$#" -ge 2 ] || fail "--endpoint needs a value"; preset RIFT_PUBLIC_ENDPOINT "$2"; shift 2 ;;
    --public-ips) [ "$#" -ge 2 ] || fail "--public-ips needs a value"; preset RIFT_PUBLIC_IPS "$2"; shift 2 ;;
    --panel) preset RIFT_WEBPANEL true; shift ;;
    --no-panel) preset RIFT_WEBPANEL false; shift ;;
    --tui) preset RIFT_TUI true; shift ;;
    --no-tui) preset RIFT_TUI false; shift ;;
    --proxy) [ "$#" -ge 2 ] || fail "--proxy needs a value"; proxy=$2; shift 2 ;;
    --proxy-kind) [ "$#" -ge 2 ] || fail "--proxy-kind needs a value"; own_kind=$2; shift 2 ;;
    --caddy-container) [ "$#" -ge 2 ] || fail "--caddy-container needs a value"; caddy_container=$2; has_caddy_container=1; shift 2 ;;
    --caddy-sites-dir) [ "$#" -ge 2 ] || fail "--caddy-sites-dir needs a value"; caddy_sites_dir=$2; shift 2 ;;
    --email) [ "$#" -ge 2 ] || fail "--email needs a value"; preset RIFT_LETSENCRYPT_EMAIL "$2"; shift 2 ;;
    --publish-panel) [ "$#" -ge 2 ] || fail "--publish-panel needs a domain"; publish=$2; has_publish=1; shift 2 ;;
    --version) [ "$#" -ge 2 ] || fail "--version needs a value"; preset RIFT_VERSION "$2"; shift 2 ;;
    --set)
      [ "$#" -ge 2 ] || fail "--set needs KEY=VALUE"
      case $2 in *=*) ;; *) fail "--set needs KEY=VALUE, not $2" ;; esac
      known_key "${2%%=*}" || fail "--set: ${2%%=*} is not a server setting (see .env.server.example)"
      preset "${2%%=*}" "${2#*=}"
      shift 2
      ;;
    --yes | -y) assume_yes=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) fail "unknown option $1 (see sh deploy/setup-server --help)" ;;
  esac
done
[ "$(id -u)" -eq 0 ] || fail "run as root: sudo sh deploy/setup-server"

interactive=
if [ -z "$assume_yes" ] && [ -t 0 ] && [ -t 1 ]; then
  interactive=1
fi

command -v docker > /dev/null 2>&1 \
  || fail "Docker is not installed. Install it first, for example: curl -fsSL https://get.docker.com | sh"
docker compose version > /dev/null 2>&1 || fail "Docker Compose v2 ('docker compose') is missing"
docker info > /dev/null 2>&1 || fail "Docker does not answer; is the docker service running?"

# Server and agent share the compose project "rift", its state volume and the host network: they
# cannot run on one machine, even from two checkouts.
if docker inspect rift-agent > /dev/null 2>&1; then
  fail "this machine runs a RIFT agent (container rift-agent); the server needs its own machine"
fi

env_existed=
if [ -f "$env_file" ]; then
  grep -Eq '^COMPOSE_PROFILES=agent' "$env_file" \
    && fail "$env_file belongs to a RIFT agent; the server needs its own checkout or machine"
  env_existed=1
fi

if [ -n "$interactive" ]; then
  if [ -n "$env_existed" ]; then
    echo "Settings of the existing .env are the defaults; Enter keeps them, - clears an optional value."
  else
    echo "Enter takes the value in brackets; - clears an optional value."
  fi
fi

# ---------- image ----------
heading "Image"
setting RIFT_VERSION "Image version: latest (follows main) or a release such as 1.0.0" is_version

# ---------- addresses ----------
heading "Addresses"
# Addresses on this machine's interfaces. Private and shared ones (RFC 1918, 100.64/10) are
# what a cloud NAT hands out; RIFT's own pools and container bridges are never candidates.
private_v4() {
  case $1 in
    10.* | 192.168.* | 172.1[6-9].* | 172.2[0-9].* | 172.3[01].* | 100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].*) return 0 ;;
    *) return 1 ;;
  esac
}
v4_public=
v4_private=
for ip in $(ip -4 -o addr show scope global 2> /dev/null | awk '$2 !~ /^(rift|docker|br-|veth|virbr|cni|flannel|wg)/ {split($4, a, "/"); print a[1]}'); do
  if private_v4 "$ip"; then
    [ -n "$v4_private" ] || v4_private=$ip
  else
    [ -n "$v4_public" ] || v4_public=$ip
  fi
done
v6_public=$(ip -6 -o addr show scope global 2> /dev/null \
  | awk '$2 !~ /^(rift|docker|br-|veth|virbr|wg)/ && $0 !~ /temporary|deprecated/ {split($4, a, "/"); print a[1]}' \
  | grep -Eiv '^f[cd]' | head -n 1 || true)

if has_preset RIFT_PUBLIC_IPS || { [ -n "$env_existed" ] && [ -n "$(get_env RIFT_PUBLIC_IPS)" ]; }; then
  setting RIFT_PUBLIC_IPS "Addresses forwards listen on (comma-separated, IPv4 first; IPv6 optional)" check_public_ips
else
  if [ -n "$v4_public" ]; then
    default_ip=$v4_public
    question="Public IPv4 address forwards listen on"
  elif [ -n "$v4_private" ]; then
    note "No public IPv4 address is assigned to an interface; this looks like a cloud NAT (Oracle Cloud, AWS, Google Cloud)."
    note "RIFT then listens on the private address $v4_private and the provider forwards the public one to it."
    default_ip=$v4_private
    question="Private IPv4 address forwards listen on"
  else
    [ -n "$interactive" ] || fail "no IPv4 address found; give one with --public-ips"
    default_ip=
    question="IPv4 address forwards listen on"
  fi
  setting RIFT_PUBLIC_IPS "$question" check_public_ips "$default_ip"
  if [ -n "$v6_public" ] && yes_no "Also publish forwards over IPv6 ($v6_public)?" n; then
    put RIFT_PUBLIC_IPS "$(get RIFT_PUBLIC_IPS),$v6_public"
  fi
fi
first_ip=$(get RIFT_PUBLIC_IPS)
first_ip=${first_ip%%,*}
if has_preset RIFT_ALLOW_PRIVATE_LISTENERS; then
  flag RIFT_ALLOW_PRIVATE_LISTENERS ""
elif is_ip4 "$first_ip" && private_v4 "$first_ip"; then
  put RIFT_ALLOW_PRIVATE_LISTENERS true
else
  put RIFT_ALLOW_PRIVATE_LISTENERS false
fi

default_endpoint=$(current RIFT_PUBLIC_ENDPOINT)
[ -n "$default_endpoint" ] || default_endpoint=$v4_public
if [ "$(get RIFT_ALLOW_PRIVATE_LISTENERS)" = true ]; then
  note "Agents need the public name or address, not $first_ip."
fi
setting RIFT_PUBLIC_ENDPOINT "DNS name or public address agents dial (a name is easier to move later)" \
  check_endpoint "$default_endpoint"

# ---------- ports and enrollment ----------
heading "Ports and enrollment"
# Another program on the enrollment port: offer a free one (only without --set for it).
enrollment_default=$(current RIFT_ENROLLMENT_BIND)
enrollment_busy=
if ! has_preset RIFT_ENROLLMENT_BIND && [ "$(current RIFT_ENROLLMENT)" != off ]; then
  _u=$(port_user "${enrollment_default##*:}")
  if [ -n "$_u" ]; then
    _free="${enrollment_default%:*}:$(free_port "${enrollment_default##*:}")"
    port_taken "${enrollment_default##*:}" "agent enrollment" "$_u" "$_free"
    enrollment_default=$_free
    enrollment_busy=y
  fi
fi
group "Change the ports (WireGuard UDP $(current RIFT_WG_PORT), enrollment $enrollment_default)?" \
  "$( { [ -n "$enrollment_busy" ] || changed RIFT_WG_PORT RIFT_ENROLLMENT_BIND; } && echo y)"
setting RIFT_WG_PORT "WireGuard UDP port" check_wg_port
setting RIFT_ENROLLMENT_BIND "Enrollment listener, ADDRESS:PORT (TCP)" check_bind "$enrollment_default"
end_group
note "The enrollment port: auto opens it only while an invitation from \"rift add agent\" is open,"
note "always keeps it open, off turns enrollment off."
setting RIFT_ENROLLMENT "Enrollment port: auto, always or off" check_enrollment

# ---------- tunnel pools ----------
heading "Tunnel addresses"
pool_warning=
overlap=$(route_overlaps "$(current RIFT_IPV4_POOL)")
if [ -n "$overlap" ]; then
  note "The tunnel pool $(current RIFT_IPV4_POOL) overlaps a route of this host: $overlap"
  pool_warning=y
fi
group "Change the tunnel pools (IPv4 $(current RIFT_IPV4_POOL), IPv6 $(current RIFT_IPV6_POOL))?" \
  "$( { [ -n "$pool_warning" ] || changed RIFT_IPV4_POOL RIFT_SERVER_IPV4 RIFT_IPV6_POOL RIFT_SERVER_IPV6; } && echo y)"
note "Changing them on a server in use needs a restart; agents get new tunnel addresses."
setting RIFT_IPV4_POOL "IPv4 tunnel pool (private, /8 to /29)" check_pool4
default_server4=$(current RIFT_SERVER_IPV4)
if [ "$(get RIFT_IPV4_POOL)" != "$(current RIFT_IPV4_POOL)" ] || ! check_server4 "$default_server4"; then
  default_server4=$(first_host4 "$(get RIFT_IPV4_POOL)")
fi
setting RIFT_SERVER_IPV4 "Server address in that pool" check_server4 "$default_server4"
setting RIFT_IPV6_POOL "IPv6 tunnel pool (ULA, fd00::/8)" check_pool6
default_server6=$(current RIFT_SERVER_IPV6)
if [ "$(get RIFT_IPV6_POOL)" != "$(current RIFT_IPV6_POOL)" ]; then
  case $(get RIFT_IPV6_POOL) in
    *::/*) default_server6=$(get RIFT_IPV6_POOL); default_server6=${default_server6%/*}1 ;;
    *) default_server6= ;;
  esac
fi
setting RIFT_SERVER_IPV6 "Server IPv6 address in that pool" is_ip6 "$default_server6"
end_group

# ---------- VPN devices ----------
heading "VPN devices (rift vpn ...)"
pool_warning=
overlap=$(route_overlaps "$(current RIFT_VPN_POOL)")
if [ -n "$overlap" ]; then
  note "The VPN pool $(current RIFT_VPN_POOL) overlaps a route of this host: $overlap"
  pool_warning=y
fi
group "Change the VPN device pools (IPv4 $(current RIFT_VPN_POOL), IPv6 $(current RIFT_VPN_POOL6))?" \
  "$( { [ -n "$pool_warning" ] || changed RIFT_VPN_POOL RIFT_VPN_POOL6; } && echo y)"
setting RIFT_VPN_POOL "IPv4 pool of VPN devices (private, not overlapping the tunnel pool or a LAN you grant)" check_vpn_pool
setting RIFT_VPN_POOL6 "IPv6 pool of VPN devices (ULA, not overlapping the IPv6 tunnel pool)" check_vpn_pool6
end_group
setting RIFT_VPN_DNS "DNS servers for devices with an internet exit (comma-separated, one IPv4 at least)" check_dns
# Another program on the name server's port: offer a free one (only without --set for it).
names_port=$(current RIFT_NAMES_PORT)
names_busy=
if ! has_preset RIFT_NAMES_PORT; then
  _u=$( { port_user "$names_port"; port_user "$names_port" udp; } | sed '/^$/d' | paste -sd, -)
  if [ -n "$_u" ]; then
    _free=$(free_port "$names_port")
    port_taken "$names_port" "RIFT's name server, TCP and UDP" "$_u" "$_free"
    names_port=$_free
    names_busy=y
  fi
fi
group "Change RIFT's names for VPN devices (NAME.$(current RIFT_NAMES_SUFFIX), name server port $names_port)?" \
  "$( { [ -n "$names_busy" ] || changed RIFT_NAMES_PORT RIFT_NAMES_SUFFIX; } && echo y)"
note "Suffix: internal (default; Safari searches for such names, type http:// or a final /),"
note "  home.arpa (also private; on the Public Suffix List browsers use), or a domain of your own (e.g. home.example.net)."
setting RIFT_NAMES_SUFFIX "Suffix of the agents' names" check_suffix
setting RIFT_NAMES_PORT "Name server port (TCP and UDP on the tunnel address; devices ask port 53)" check_names_port "$names_port"
end_group

# ---------- web panel ----------
heading "Web panel"
flag RIFT_WEBPANEL "Turn on the web panel?"
panel=$(get RIFT_WEBPANEL)
[ "$panel" = true ] || asking=
password_note=
if has_preset RIFT_WEBPANEL_PASSWORD; then
  setting RIFT_WEBPANEL_PASSWORD "" check_password
elif [ -n "$interactive" ] && [ -n "$asking" ]; then
  if [ -n "$(current RIFT_WEBPANEL_PASSWORD)" ]; then
    secret "Panel password (hidden; Enter keeps the current one)" check_password
  else
    secret "Panel password, at least 12 characters (hidden; Enter generates one)" check_password
  fi
  [ -n "$answer" ] || answer=$(current RIFT_WEBPANEL_PASSWORD)
  put RIFT_WEBPANEL_PASSWORD "$answer"
else
  put RIFT_WEBPANEL_PASSWORD "$(current RIFT_WEBPANEL_PASSWORD)"
fi
[ -n "$(get RIFT_WEBPANEL_PASSWORD)" ] || password_note=" (generated; show it with: rift panel password)"
note "Two-factor login: optional (turn it on later in the panel), required (no login until \"rift panel 2fa setup\")."
setting RIFT_WEBPANEL_2FA "Two-factor login: optional or required" check_2fa
note "private (recommended): on the VPS itself (SSH tunnel), for VPN devices from \"rift panel connect\","
note "  and through the reverse proxy if you give the panel a domain under Websites below."
note "public: the panel itself on every address over plain HTTP (port $(current RIFT_WEBPANEL_PORT)); rarely needed."
setting RIFT_WEBPANEL_ACCESS "Where the panel listens: private or public" check_access
note "Who may change things: private (the VPS itself and panel VPN devices), public (also through"
note "a TLS proxy over HTTPS; a panel domain under Websites asks again), off (read-only)."
setting RIFT_WEBPANEL_CONTROL "Changes allowed from: private, public or off" check_control
# Another program on the panel port: offer a free one (only without --set for it).
panel_port=$(current RIFT_WEBPANEL_PORT)
panel_busy=
if [ "$panel" = true ] && ! has_preset RIFT_WEBPANEL_PORT; then
  _u=$(port_user "$panel_port")
  if [ -n "$_u" ]; then
    _free=$(free_port "$panel_port")
    port_taken "$panel_port" "web panel" "$_u" "$_free"
    panel_port=$_free
    panel_busy=y
  fi
fi
if [ -n "$asking" ]; then
  group "Change advanced panel settings (port $panel_port, allowed addresses, TLS proxies)?" \
    "$( { [ -n "$panel_busy" ] || changed RIFT_WEBPANEL_PORT RIFT_WEBPANEL_ALLOW RIFT_WEBPANEL_PROXIES RIFT_WEBPANEL_INSECURE; } && echo y)"
fi
setting RIFT_WEBPANEL_PORT "Panel TCP port" check_panel_port "$panel_port"
note "Extra addresses that may open the panel read-only (rarely needed; public mode: restricts the panel to them)."
setting RIFT_WEBPANEL_ALLOW "Allowed addresses or networks (comma-separated, empty for none)" check_addr_list
setting RIFT_WEBPANEL_PROXIES "TLS proxies in front of the panel (comma-separated; empty if the proxy runs on this VPS)" check_addr_list
if [ "$(get RIFT_WEBPANEL_ACCESS)" = public ]; then
  flag RIFT_WEBPANEL_INSECURE "Allow the password over plain HTTP (test setups only)?"
else
  put RIFT_WEBPANEL_INSECURE "$(current RIFT_WEBPANEL_INSECURE)"
fi
end_group

# ---------- terminal UI ----------
heading "Terminal UI"
note "\"rift\" without a command opens a full-screen terminal UI here (keyboard and mouse) for"
note "everything the commands and the panel do. Every rift command keeps working either way."
flag RIFT_TUI "Turn on the terminal UI?"

# ---------- websites ----------
heading "Websites (rift add site)"
# The proxy deploy/setup-proxy set up before, if any.
existing_proxy=none
for container in traefik rift-caddy rift-npm; do
  wd=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$container" 2> /dev/null || true)
  case $wd in
    /opt/rift-traefik) existing_proxy=traefik; break ;;
    /opt/rift-caddy) existing_proxy=caddy; break ;;
    /opt/rift-npm) existing_proxy=npm; break ;;
  esac
done
# Another program on port 443: its proxy kind and, for a container, its name. The same rules
# as edge_holders in deploy/vps/rift-site: a host process first, then a container.
kind_of() {
  _b=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case $_b in *proxy-manager*) echo npm; return 0 ;; esac
  if printf '%s\n' "$_b" | grep -Eq '(^|[^a-z0-9])npm([^a-z0-9]|$)'; then echo npm; return 0; fi
  _hits=
  for _k in traefik caddy nginx; do
    case $_b in *"$_k"*) _hits="$_hits $_k" ;; esac
  done
  # shellcheck disable=SC2086
  set -- $_hits
  [ "$#" -ne 1 ] || echo "$1"
}
foreign_holder=
foreign_kind=
foreign_container=
if [ "$existing_proxy" = none ]; then
  for process in $(ss -Hltnp 'sport = :443' 2> /dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | sort -u); do
    [ "$process" != docker-proxy ] || continue
    foreign_holder=$process
    foreign_kind=$(kind_of "$process")
    [ -z "$foreign_kind" ] || break
  done
  if [ -z "$foreign_kind" ]; then
    row=$(docker ps --format '{{.Names}} {{.Image}} {{.Ports}}' 2> /dev/null \
      | awk '$0 ~ /(0\.0\.0\.0|\[::\]|:::):443->/ {print $1, $2; exit}')
    if [ -n "$row" ]; then
      foreign_container=${row%% *}
      foreign_holder="container $foreign_container"
      foreign_kind=$(kind_of "$row")
    fi
  fi
fi
# What `rift proxy` stored before (rerun): the default proxy and Caddy's site directory.
state_proxy=
state_caddy_dir=
state_caddy_container=
if [ -f "$site_state" ]; then
  state_proxy=$(sed -n 's/^  "proxy": "\([a-z]*\)".*/\1/p' "$site_state" | head -n 1)
  state_caddy_dir=$(sed -n '/^  "caddy": {/,/^  }/s/.*"sites_dir": *"\([^"]*\)".*/\1/p' "$site_state" | head -n 1)
  state_caddy_container=$(sed -n '/^  "caddy": {/,/^  }/p' "$site_state" | tr -d ' \n' \
    | sed -n 's/.*"reload":\["docker","exec","\([^"]*\)".*/\1/p')
fi

default_proxy=$existing_proxy
[ "$default_proxy" != none ] || [ -z "$foreign_holder" ] || default_proxy=own
if [ -z "$proxy" ]; then
  note "A reverse proxy serves websites with HTTPS (\"rift add site\"); it needs ports 80 and 443."
  note "  traefik, caddy, npm  set one up in Docker (deploy/setup-proxy; npm is Nginx Proxy Manager)"
  note "  own                  use a proxy that already runs here: Traefik, Caddy, Nginx with certbot or NPM"
  note "  none                 no websites for now (later: sudo sh deploy/setup-proxy NAME)"
  if [ -n "$foreign_holder" ]; then
    note "Port 443 is held by $foreign_holder${foreign_kind:+ ($foreign_kind)}."
  fi
  while :; do
    ask "Reverse proxy: traefik, caddy, npm, own or none" "$default_proxy" check_proxy
    proxy=$answer
    case $proxy in
      traefik | caddy | npm)
        if [ -n "$foreign_holder" ]; then
          note "deploy/setup-proxy does not take port 443 from $foreign_holder; choose own to use it,"
          note "or stop and disable it first."
          yes_no "Set up $proxy anyway?" n || continue
        fi
        ;;
    esac
    break
  done
fi
check_proxy "$proxy" || fail "--proxy: $why"
migrate=
if [ "$proxy" != none ] && [ "$proxy" != own ] && [ "$existing_proxy" != none ] && [ "$proxy" != "$existing_proxy" ]; then
  note "$existing_proxy runs now; switching stops it and moves every site to $proxy (new certificates)."
  yes_no "Switch from $existing_proxy to $proxy?" y || fail "nothing changed"
  migrate=1
fi
if [ "$proxy" = none ] && [ "$existing_proxy" != none ]; then
  note "$existing_proxy keeps running; this script does not remove it."
elif [ "$proxy" = none ] && [ -n "$foreign_holder" ]; then
  note "$foreign_holder keeps port 443; choose own to let \"rift add site\" use it."
fi

# A proxy of your own: which one it is and what `rift add site` needs to reach it.
write_npm=
if [ "$proxy" = own ]; then
  if [ -z "$own_kind" ]; then
    ask "Which proxy is it: traefik, caddy, nginx or npm" "${foreign_kind:-$state_proxy}" check_kind
    own_kind=$answer
  fi
  check_kind "$own_kind" || fail "--proxy-kind: $why"
  case $own_kind in
    traefik)
      note "\"rift add site\" needs Traefik from Docker Compose with the container name traefik; the first"
      note "site adds a watched file provider to it (README: Set up a proxy by hand)."
      ;;
    nginx)
      note "\"rift add site\" writes /etc/nginx/rift-sites/DOMAIN.conf: include /etc/nginx/rift-sites/*.conf;"
      note "in the http block. certbot with its Nginx plugin requests the certificates."
      ;;
    caddy)
      if [ -z "$caddy_container" ] && [ -z "$has_caddy_container" ]; then
        in_docker=n
        [ -n "$foreign_container" ] || [ -n "$state_caddy_container" ] && in_docker=y
        if yes_no "Does Caddy run in a Docker container?" "$in_docker"; then
          ask "Name of the Caddy container" "${state_caddy_container:-$foreign_container}" check_container
          caddy_container=$answer
        fi
      fi
      if [ -n "$caddy_container" ]; then
        check_container "$caddy_container" || fail "--caddy-container: $why"
        if [ -z "$caddy_sites_dir" ]; then
          mount=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy"}}{{.Source}}{{end}}{{end}}' "$caddy_container" 2> /dev/null || true)
          ask "Host directory for the site files, mounted into the container (the Caddyfile imports them)" \
            "${state_caddy_dir:-${mount:+$mount/rift-sites}}" check_abs_dir
          caddy_sites_dir=$answer
        fi
        check_abs_dir "$caddy_sites_dir" || fail "--caddy-sites-dir: $why"
        note "The Caddyfile must import that directory as seen in the container, e.g. import /etc/caddy/rift-sites/*.caddy"
      else
        caddy_sites_dir=
        note "Caddy on the host: the Caddyfile must contain  import /etc/caddy/rift-sites/*.caddy"
      fi
      ;;
    npm)
      write_npm=1
      note "\"rift add site\" uses the API of Nginx Proxy Manager on http://127.0.0.1:81 with an admin login."
      setting RIFT_NPM_EMAIL "Nginx Proxy Manager admin login (e-mail)" is_email
      if has_preset RIFT_NPM_PASSWORD; then
        setting RIFT_NPM_PASSWORD "" check_npm_password
      elif [ -n "$interactive" ]; then
        if [ -n "$(current RIFT_NPM_PASSWORD)" ]; then
          secret "Its password (hidden; Enter keeps the current one)" check_npm_password
        else
          secret "Its password (hidden)" check_npm_password
        fi
        [ -n "$answer" ] || answer=$(current RIFT_NPM_PASSWORD)
        put RIFT_NPM_PASSWORD "$answer"
      else
        put RIFT_NPM_PASSWORD "$(current RIFT_NPM_PASSWORD)"
      fi
      [ -n "$(get RIFT_NPM_PASSWORD)" ] || fail "RIFT_NPM_PASSWORD: the Nginx Proxy Manager admin password is needed"
      ;;
  esac
fi

# Let's Encrypt: npm of deploy/setup-proxy needs the address (its login); RIFT requests the
# certificates itself only for Nginx (certbot) and Nginx Proxy Manager.
case $proxy:$own_kind in
  npm:*)
    setting RIFT_LETSENCRYPT_EMAIL "E-mail address for Let's Encrypt and the Nginx Proxy Manager login" is_email
    flag RIFT_REQUEST_CERTIFICATE "Request a Let's Encrypt certificate for each new site (accepts the Let's Encrypt terms)?"
    ;;
  own:nginx | own:npm)
    setting RIFT_LETSENCRYPT_EMAIL "E-mail address for Let's Encrypt expiry notices (optional)" maybe_email
    flag RIFT_REQUEST_CERTIFICATE "Request a Let's Encrypt certificate for each new site (accepts the Let's Encrypt terms)?"
    ;;
  traefik:* | caddy:*)
    setting RIFT_LETSENCRYPT_EMAIL "E-mail address for Let's Encrypt expiry notices (optional)" maybe_email
    put RIFT_REQUEST_CERTIFICATE "$(current RIFT_REQUEST_CERTIFICATE)"
    ;;
  *)
    asking=
    setting RIFT_LETSENCRYPT_EMAIL "" maybe_email
    flag RIFT_REQUEST_CERTIFICATE ""
    end_group
    ;;
esac
# The Docker network of deploy/setup-proxy's proxies; kept as it is for the other choices.
case $proxy in traefik | caddy | npm) ;; *) asking= ;; esac
setting RIFT_PROXY_SUBNET "Docker network of the proxy (the panel trusts it)" is_net4
end_group
for key in RIFT_NPM_EMAIL RIFT_NPM_PASSWORD; do
  if has_preset "$key" && [ -z "$write_npm" ]; then
    setting "$key" ""
  fi
done
[ -z "$(get RIFT_NPM_EMAIL)" ] || is_email "$(get RIFT_NPM_EMAIL)" || fail "RIFT_NPM_EMAIL: $why"

# The panel route of deploy/publish-panel: https://DOMAIN through the proxy.
current_route=
if [ -f "$site_state" ]; then
  current_route=$(sed -n '/"panel": {/,/}/s/.*"host": *"\([^"]*\)".*/\1/p' "$site_state" | head -n 1)
fi
# A proxy of your own in Docker reaches the panel from the network its routing picks;
# deploy/publish-panel trusts that network (README: Reach the panel over HTTPS).
publish_blocked=
publish_trust=
if [ "$proxy" = own ] && [ -n "$foreign_container" ]; then
  panel_source_net "$foreign_container" "$(get RIFT_SERVER_IPV4)"
  if [ -z "$source_net" ]; then
    publish_blocked="it is unclear from which address $foreign_container reaches the panel (nsenter and ip are needed)"
  elif [ "$source_net" != "$(get RIFT_PROXY_SUBNET)" ]; then
    publish_trust="$foreign_container reaches the panel from its Docker network $source_net; the panel trusts that network as its proxy (its containers reach the login like anyone through the domain)"
  fi
fi
proxy_name=$proxy
[ "$proxy" != own ] || proxy_name="your $own_kind"
if [ -z "$has_publish" ]; then
  publish=$current_route
  # A route to a panel that is off goes; with no proxy chosen here the existing one keeps it.
  [ "$panel" = true ] || publish=
  if [ "$panel" = true ] && [ "$proxy" != none ] && [ -n "$publish_blocked" ]; then
    note "The panel stays reachable over SSH and the VPN; $publish_blocked."
  elif [ "$panel" = true ] && [ "$proxy" != none ]; then
    if yes_no "Also reach the panel at https://DOMAIN through $proxy_name (for networks that block WireGuard)?" \
      "$([ -n "$current_route" ] && echo y || echo n)"; then
      ask "Domain for the panel (its A record points at this server)" "$current_route" is_domain
      publish=$answer
      [ -z "$publish_trust" ] || note "$publish_trust."
    else
      publish=
      [ -z "$current_route" ] || note "The route https://$current_route is removed."
    fi
  fi
elif [ "$publish" = - ]; then
  publish=
fi
if [ -n "$publish" ] && [ "$publish" != "$current_route" ] && [ -n "$publish_blocked" ]; then
  fail "$publish_blocked"
fi
maybe_domain "$publish" || fail "--publish-panel: $why"
if [ -n "$publish" ]; then
  [ "$panel" = true ] || fail "publishing the panel needs the web panel on (--panel)"
  [ "$proxy" != none ] || [ "$publish" = "$current_route" ] \
    || fail "publishing the panel needs a proxy (--proxy traefik|caddy|npm|own)"
  # Read-only through the domain unless changes are allowed there (RIFT_WEBPANEL_CONTROL=public).
  note "Through https://$publish logins work. Read-only (recommended): changes and secrets stay on"
  note "the VPS, SSH tunnels and panel VPN devices. With changes, only the password (and the code,"
  note "if two-factor login is on) protects your network from the internet."
  if yes_no "Allow changes through https://$publish?" "$([ "$(get RIFT_WEBPANEL_CONTROL)" = public ] && echo y || echo n)"; then
    put RIFT_WEBPANEL_CONTROL public
    [ "$(get RIFT_WEBPANEL_2FA)" = required ] || note "Turn two-factor login on: rift panel 2fa setup"
  elif [ "$(get RIFT_WEBPANEL_CONTROL)" = public ]; then
    put RIFT_WEBPANEL_CONTROL private
  fi
fi
publish_mode=
[ "$(get RIFT_WEBPANEL_CONTROL)" = public ] || publish_mode=--read-only

# ---------- summary ----------
version=$(get RIFT_VERSION)
# The summary, in the order of the questions, one block per section.
line() { printf '    %-29s %s\n' "$1" "$2"; }
show() {
  for _s in "$@"; do
    _v=$(get "$_s")
    [ "$_v" = "$(builtin "$_s")" ] && [ -n "$_v" ] && _v="$_v (default)"
    line "$_s" "${_v:-(empty)}"
  done
}
secret_line() {
  if [ -n "$(get "$1")" ]; then line "$1" "(set)"; else line "$1" "$2"; fi
}
echo
echo "Settings:"
echo "  Image"
show RIFT_VERSION
echo "  Addresses"
show RIFT_PUBLIC_IPS RIFT_ALLOW_PRIVATE_LISTENERS RIFT_PUBLIC_ENDPOINT
echo "  Ports and enrollment"
show RIFT_WG_PORT RIFT_ENROLLMENT_BIND RIFT_ENROLLMENT
echo "  Tunnel addresses"
show RIFT_IPV4_POOL RIFT_SERVER_IPV4 RIFT_IPV6_POOL RIFT_SERVER_IPV6
echo "  VPN devices"
show RIFT_VPN_POOL RIFT_VPN_POOL6 RIFT_VPN_DNS RIFT_NAMES_SUFFIX RIFT_NAMES_PORT
echo "  Web panel"
show RIFT_WEBPANEL
if [ "$panel" = true ]; then
  secret_line RIFT_WEBPANEL_PASSWORD "(generated)"
  show RIFT_WEBPANEL_2FA RIFT_WEBPANEL_ACCESS RIFT_WEBPANEL_CONTROL RIFT_WEBPANEL_PORT \
    RIFT_WEBPANEL_ALLOW RIFT_WEBPANEL_PROXIES RIFT_WEBPANEL_INSECURE
  panel_port=$(get RIFT_WEBPANEL_PORT)
  if [ "$(get RIFT_WEBPANEL_ACCESS)" = public ]; then
    line "Reachable at" "http://ADDRESS:$panel_port on every address (logins only through a TLS proxy)"
  else
    line "Reachable at" "http://127.0.0.1:$panel_port on the VPS or through an SSH tunnel"
    line "" "http://$(get RIFT_SERVER_IPV4):$panel_port from VPN devices of \"rift panel connect\""
  fi
  if [ -n "$publish" ]; then
    if [ "$(get RIFT_WEBPANEL_CONTROL)" = public ]; then
      line "" "https://$publish through the proxy (changes allowed)"
    else
      line "" "https://$publish through the proxy (read-only)"
    fi
  else
    line "" "(no HTTPS domain)"
  fi
else
  line "Reachable at" "nowhere (the panel is off; its other settings are kept)"
fi
echo "  Terminal UI"
show RIFT_TUI
echo "  Websites"
case $proxy in
  own) proxy_line="your own $own_kind${caddy_container:+ in Docker ($caddy_container, $caddy_sites_dir)}" ;;
  none) proxy_line="none (nothing is set up)" ;;
  *) proxy_line="$proxy in Docker${migrate:+ (switch from $existing_proxy)}" ;;
esac
line "Reverse proxy" "$proxy_line"
[ -z "$(get RIFT_NPM_EMAIL)" ] || show RIFT_NPM_EMAIL
[ -z "$(get RIFT_NPM_PASSWORD)" ] || secret_line RIFT_NPM_PASSWORD ""
show RIFT_LETSENCRYPT_EMAIL RIFT_REQUEST_CERTIFICATE RIFT_PROXY_SUBNET
if [ "$version" != latest ]; then
  echo "The image is pinned to $version; check out the matching tag too: git checkout v$version"
fi
if [ -n "$interactive" ]; then
  yes_no "Set up the server with these values?" y || fail "nothing changed"
fi

steps=5
[ "$proxy" = none ] || steps=$((steps + 1))
publish_step=
if [ "$publish" != "$current_route" ]; then
  steps=$((steps + 1))
  publish_step=$steps
fi

echo "1/$steps Preparing the host"
sh "$script_dir/prepare-host"

echo "2/$steps Writing config.toml and .env"
[ -f "$config_file" ] || cp "$script_dir/vps/config.toml" "$config_file"
umask 077
[ -f "$env_file" ] || cp "$repo_dir/.env.server.example" "$env_file"
chmod 600 "$env_file"
put_env COMPOSE_PROFILES server
for key in $keys; do
  value=$(get "$key")
  case $key in
    RIFT_PUBLIC_ENDPOINT | RIFT_PUBLIC_IPS | RIFT_WEBPANEL) put_env "$key" "$value" ;;
    RIFT_NPM_EMAIL | RIFT_NPM_PASSWORD)
      # deploy/setup-proxy keeps these; only --set changes them here.
      if has_preset "$key" || [ -n "$write_npm" ]; then put_env "$key" "$(env_quote "$value")"; fi
      ;;
    *)
      if [ -z "$value" ] || [ "$value" = "$(builtin "$key")" ]; then
        default_env "$key" "$(builtin "$key")"
      else
        put_env "$key" "$value"
      fi
      ;;
  esac
done
umask 022

echo "3/$steps Installing the rift command and the site helper"
sh "$script_dir/install-cli"

echo "4/$steps Starting the server"
cd "$repo_dir"
docker compose pull --quiet
docker compose up -d --force-recreate

echo "5/$steps Waiting for the server to be ready"
ready=
i=0
while [ "$i" -lt 60 ]; do
  if docker exec rift-server rift --config /etc/rift/config.toml status > /dev/null 2>&1; then
    ready=1
    break
  fi
  i=$((i + 1))
  sleep 2
done
if [ -z "$ready" ]; then
  echo "rift: the server is not ready after two minutes. Its last messages:" >&2
  docker logs --tail 10 rift-server 2>&1 | sed 's/^/  /' >&2
  echo "rift: fix the setting it names in $env_file, or run this script again." >&2
  exit 1
fi

failed=
if [ "$proxy" = own ]; then
  echo "6/$steps Making your $own_kind the proxy of \"rift add site\""
  if [ -n "$caddy_container" ]; then
    set -- caddy --container "$caddy_container" --sites-dir "$caddy_sites_dir"
  elif [ "$own_kind" = caddy ]; then
    set -- caddy --host
  else
    set -- "$own_kind"
  fi
  # rift proxy prints the proxy name first, which says nothing here; the rest (moved routes) does.
  if output=$(rift proxy "$@"); then
    printf '%s\n' "$output" | sed '1d'
  else
    failed="\"rift proxy\" failed (see above); run: sudo rift proxy $*"
  fi
elif [ "$proxy" != none ]; then
  echo "6/$steps Setting up $proxy"
  email=$(get RIFT_LETSENCRYPT_EMAIL)
  RIFT_NO_NEXT_STEPS=1 sh "$script_dir/setup-proxy" "$proxy" ${email:+--email "$email"} ${migrate:+--migrate} --yes \
    || failed="$proxy was not set up (see above); run: sudo sh deploy/setup-proxy $proxy${migrate:+ --migrate}"
fi
if [ -n "$publish_step" ] && [ -z "$failed" ]; then
  if [ -n "$publish" ]; then
    echo "$publish_step/$steps Publishing the panel at https://$publish"
    RIFT_NO_NEXT_STEPS=1 sh "$script_dir/publish-panel" "$publish" $publish_mode --yes \
      || failed="the panel was not published (see above); run: sudo sh deploy/publish-panel $publish $publish_mode"
  else
    echo "$publish_step/$steps Removing the panel route https://$current_route"
    sh "$script_dir/publish-panel" --off --yes \
      || failed="the panel route was not removed (see above); run: sudo sh deploy/publish-panel --off"
  fi
fi

enrollment_port=$(get RIFT_ENROLLMENT_BIND)
enrollment_port=${enrollment_port##*:}
port_line() { printf '  %-13s %s\n' "$1" "$2"; }
echo
echo "The RIFT server is running."
echo
echo "Open in your cloud firewall or security group:"
port_line "UDP $(get RIFT_WG_PORT)" "WireGuard"
case $(get RIFT_ENROLLMENT) in
  auto) port_line "TCP $enrollment_port" "agent enrollment (listens only while an invitation is open)" ;;
  always) port_line "TCP $enrollment_port" "agent enrollment" ;;
esac
if [ "$panel" = true ] && [ "$(get RIFT_WEBPANEL_ACCESS)" = public ]; then
  port_line "TCP $(get RIFT_WEBPANEL_PORT)" "web panel"
fi
[ "$proxy" = none ] || port_line "TCP 80, 443" "websites"
echo "  and later the ports of your forwards"
next_steps
if [ "$(get RIFT_TUI)" = true ]; then
  next_step "Manage everything in the terminal UI (keyboard and mouse)" "rift"
fi
next_step "Add an agent (prints the command to run on the agent host)" "rift add agent NAME"
if [ "$proxy" != none ]; then
  next_step "Publish a website of an agent (its domain's A record points at this server)" "sudo rift add site AGENT DOMAIN PORT"
fi
if [ "$panel" = true ]; then
  next_step "Connect a device to the web panel" "rift panel connect laptop"
  [ -z "$password_note" ] || next_step "Show the generated panel password" "rift panel password"
  if [ "$(get RIFT_WEBPANEL_CONTROL)" = public ] && [ "$(get RIFT_WEBPANEL_2FA)" != required ]; then
    next_step "Turn on two-factor login (changes are allowed through a proxy)" "rift panel 2fa setup"
  fi
fi
if [ -n "$failed" ]; then
  echo "The server runs, but $failed" >&2
  exit 1
fi
