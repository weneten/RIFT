#!/bin/sh
# Install the host command `rift` on this host. The role comes from the root .env (COMPOSE_PROFILES).
# On the server (VPS) it also installs the website helper and the host service that carries site
# requests from the web panel (see README: Web panel). Safe to run again.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

role=
if [ -f "$repo_dir/.env" ]; then
    role=$(sed -n -E 's/^COMPOSE_PROFILES=(server|agent)([[:space:]]+#.*)?[[:space:]]*$/\1/p' "$repo_dir/.env" 2> /dev/null | tail -n 1 || true)
fi
case "$role" in
    server | agent) ;;
    *)
        printf '%s\n' "rift: $repo_dir/.env is missing or has no COMPOSE_PROFILES=server or agent line." \
            'Create it from the matching example first, then run this again:' \
            '  VPS:         cp .env.server.example .env' \
            '  home server: cp .env.agent.example .env' >&2
        exit 1
        ;;
esac

install -d -m 755 /usr/local/bin
install -m 755 "$script_dir/rift" /usr/local/bin/rift

if [ "$role" = agent ]; then
    printf '%s\n' 'Installed /usr/local/bin/rift. On this agent, rift status, rift doctor and rift logs' \
        'now run inside the rift-agent container.'
    exit 0
fi

install -d -m 755 /usr/local/lib/rift
install -m 755 "$script_dir/vps/rift-site" /usr/local/lib/rift/rift-site
printf '%s\n' 'Installed /usr/local/bin/rift and /usr/local/lib/rift/rift-site.'

# The server container reads the site records (read-only) and writes requests into the queue
# (read-write); only the queue is writable from the container. Created before the first
# `docker compose up`, with the modes the host service expects.
install -d -m 755 /var/lib/rift-site
install -d -m 700 /var/lib/rift-site-queue
chmod 700 /var/lib/rift-site-queue

if [ ! -d /run/systemd/system ] || ! command -v systemctl > /dev/null 2>&1; then
    printf '%s\n' 'No systemd here: the web panel cannot add or remove sites. Run' \
        '  sudo rift add site / sudo rift remove site' \
        'on the server instead.'
    exit 0
fi

cat > /etc/systemd/system/rift-site-queue.path << 'EOF'
[Unit]
Description=Site requests from the RIFT web panel

[Path]
PathExistsGlob=/var/lib/rift-site-queue/????????????????????????????????.json

[Install]
WantedBy=multi-user.target
EOF
cat > /etc/systemd/system/rift-site-queue.service << 'EOF'
[Unit]
Description=Process site requests from the RIFT web panel
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/rift/rift-site process-queue
EOF
systemctl daemon-reload
systemctl enable --now rift-site-queue.path
printf '%s\n' 'Enabled rift-site-queue.path: the web panel can now add and remove sites.'
