#!/bin/sh
# One host step before the container starts. RIFT does not change these
# host-wide sysctls itself: a write from the container is often read-only and
# does not survive reboot. Safe to run again.
set -eu
if [ "$(id -u)" -ne 0 ]; then
  echo "rift: run as root: sudo sh deploy/prepare-host" >&2
  exit 1
fi
conf=/etc/sysctl.d/99-rift.conf
umask 022
cat > "$conf" << 'EOF'
# Installed by deploy/prepare-host for the RIFT tunnel.
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.ipv4.conf.default.rp_filter = 2
EOF
write_sysctl() {
  printf '%s\n' "$2" > "/proc/sys/$(printf '%s' "$1" | tr . /)"
}
write_sysctl net.ipv4.ip_forward 1
write_sysctl net.ipv6.conf.all.forwarding 1
write_sysctl net.ipv4.conf.default.rp_filter 2
ns=rift-preflight-$$
ip netns add "$ns"
trap 'ip netns del "$ns" 2>/dev/null || true' EXIT
if ! ip -n "$ns" link add rift-probe type wireguard; then
  modprobe wireguard 2>/dev/null || true
  if ! ip -n "$ns" link add rift-probe type wireguard; then
    echo "rift: this kernel cannot create a WireGuard interface" >&2
    exit 1
  fi
fi
echo "rift: forwarding sysctls installed in $conf"
