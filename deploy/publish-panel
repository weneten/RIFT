#!/bin/sh
# Make the web panel reachable at https://DOMAIN through the reverse proxy of
# deploy/setup-proxy, for networks where WireGuard (UDP) is blocked:
#
#   sudo sh deploy/publish-panel panel.example.net [--read-only] [--yes]
#   sudo sh deploy/publish-panel --off
#
# The panel itself stays private (loopback and the server's tunnel address); only the proxy
# reaches it. By default changes are allowed through the proxy (RIFT_WEBPANEL_CONTROL=public),
# so the panel password, and the code if two-factor login is on, is all that protects your
# network from the internet: turn two-factor login on (rift panel 2fa setup).
# --read-only keeps the route read-only (RIFT_WEBPANEL_CONTROL=private, or off if it was off):
# logins work there, changes and secrets only on the VPS, through an SSH tunnel or from a
# panel VPN device. Running it again with or without --read-only switches between the two.
# --off removes the route and makes the proxy path read-only again.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
env_file=$repo_dir/.env
site_helper=/usr/local/lib/rift/rift-site
default_subnet=10.255.13.0/24

fail() {
  printf 'rift: %s\n' "$*" >&2
  exit 1
}

domain=
off=
read_only=
assume_yes=
while [ "$#" -gt 0 ]; do
  case $1 in
    --off) off=1; shift ;;
    --read-only) read_only=1; shift ;;
    --yes | -y) assume_yes=1; shift ;;
    -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
    -*) fail "unknown option $1 (see sh deploy/publish-panel --help)" ;;
    *) [ -z "$domain" ] || fail "name one domain"; domain=$1; shift ;;
  esac
done
[ -n "$domain" ] || [ -n "$off" ] || fail "name the domain: sudo sh deploy/publish-panel panel.example.net"
[ -z "$off" ] || [ -z "$read_only" ] || fail "--off removes the route; --read-only is for publishing one"
[ "$(id -u)" -eq 0 ] || fail "run as root: sudo sh deploy/publish-panel ..."
[ -f "$env_file" ] && grep -Eq '^COMPOSE_PROFILES=server' "$env_file" \
  || fail "no RIFT server here ($env_file); run sudo sh deploy/setup-server first"
[ -x "$site_helper" ] || fail "the site helper is missing; run sudo sh deploy/install-cli first"
docker info > /dev/null 2>&1 || fail "Docker does not answer; is the docker service running?"

subnet=$(sed -n 's/^RIFT_PROXY_SUBNET=//p' "$env_file" | tail -n 1)
subnet=${subnet:-$default_subnet}
env_value() { sed -n "s/^$1=//p" "$env_file" | tail -n 1; }

umask 077
. "$script_dir/env.sh"
. "$script_dir/ask.sh"
. "$script_dir/proxy-net.sh"

restart_server() {
  echo "Restarting the server with the new panel settings"
  (cd "$repo_dir" && docker compose up -d > /dev/null)
  i=0
  until docker exec rift-server rift --config /etc/rift/config.toml status > /dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 60 ] || fail "the server is not ready after two minutes; see: docker logs rift-server"
    sleep 2
  done
}

# A comma-separated list setting with or without the network $2.
without_net() {
  printf '%s' "$1" | tr ',' '\n' | grep -vxF "$2" | paste -sd, -
}
with_net() {
  case ",$1," in
    *",$2,"*) printf '%s' "$1" ;;
    ",,") printf '%s' "$2" ;;
    *) printf '%s,%s' "$1" "$2" ;;
  esac
}

# A proxy on the host reaches the panel on loopback, which needs no entry. A proxy in a
# Docker container reaches it on the server's tunnel address, from the network its own
# routing picks: deploy/setup-proxy's network ($subnet), or the network of your own proxy.
# That network goes into RIFT_WEBPANEL_PROXIES and RIFT_WEBPANEL_ALLOW. Containers in it can
# then reach the panel's login like anyone can through https://DOMAIN.
holder=$(docker ps --format '{{.Names}} {{.Ports}}' | awk 'index($0, ":443->") {print $1; exit}')
server_ip=$(env_value RIFT_SERVER_IPV4)
trust_net=
if [ -n "$holder" ]; then
  panel_source_net "$holder" "${server_ip:-10.13.0.1}"
  trust_net=$source_net
fi

if [ -n "$off" ]; then
  "$site_helper" panel-route --off
  put_env RIFT_WEBPANEL_CONTROL private
  for key in RIFT_WEBPANEL_PROXIES RIFT_WEBPANEL_ALLOW; do
    value=$(without_net "$(env_value "$key")" "$subnet")
    [ -z "$trust_net" ] || value=$(without_net "$value" "$trust_net")
    put_env "$key" "$value"
  done
  restart_server
  echo "The panel is no longer published; through a proxy it is read-only again."
  exit 0
fi

printf '%s\n' "$domain" | grep -Eq '^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$' \
  || fail "not a domain name: $domain"

if [ -n "$holder" ] && [ -z "$trust_net" ]; then
  fail "cannot tell from which address the proxy container $holder reaches the panel (nsenter and ip are needed on this host)"
fi

if [ -z "$assume_yes" ] && [ -t 0 ] && [ -t 1 ]; then
  if [ -n "$read_only" ]; then
    echo "This makes the panel reachable at https://$domain, read-only: logins work there,"
    echo "changes and secrets only on the VPS, through an SSH tunnel or from a panel VPN device."
  else
    echo "This makes the panel reachable at https://$domain and allows changes there."
    echo "Anyone with the panel password (and the code, if two-factor login is on) can then"
    echo "publish ports, invite agents and create VPN devices from anywhere."
  fi
  printf 'Go on? [y/N]: ' > /dev/tty
  read -r reply < /dev/tty || reply=
  case $reply in [yY]*) ;; *) fail "nothing changed" ;; esac
fi

put_env RIFT_WEBPANEL true
if [ -z "$read_only" ]; then
  put_env RIFT_WEBPANEL_CONTROL public
elif [ "$(env_value RIFT_WEBPANEL_CONTROL)" != off ]; then
  put_env RIFT_WEBPANEL_CONTROL private
fi
if [ -n "$trust_net" ]; then
  put_env RIFT_WEBPANEL_PROXIES "$(with_net "$(env_value RIFT_WEBPANEL_PROXIES)" "$trust_net")"
  put_env RIFT_WEBPANEL_ALLOW "$(with_net "$(env_value RIFT_WEBPANEL_ALLOW)" "$trust_net")"
fi
umask 022
restart_server

"$site_helper" panel-route "$domain"

echo
echo "The panel is at https://$domain once the domain's A record points at this server."
if [ -n "$trust_net" ] && [ "$trust_net" != "$subnet" ]; then
  echo "The proxy container $holder reaches the panel from its Docker network $trust_net, which the"
  echo "panel now trusts as its proxy. If that network is recreated with another range, run this again."
fi
if [ -n "$read_only" ]; then
  echo "It is read-only there; change things on the VPS, through an SSH tunnel or from a panel"
  echo "VPN device (\"rift panel connect\")."
  two_factor_off=
elif docker exec rift-server rift --config /etc/rift/config.toml --json panel 2fa status 2> /dev/null | grep -q '"enabled":true'; then
  echo "Changes are allowed there. Two-factor login is on."
  two_factor_off=
else
  echo "WARNING: two-factor login is off. The panel password alone now allows changes from the"
  echo "internet."
  two_factor_off=1
fi
next_steps
[ -z "$two_factor_off" ] || next_step "Turn on two-factor login" "rift panel 2fa setup"
next_step "Show the panel password" "rift panel password"
[ -z "$read_only" ] || next_step "Allow changes through https://$domain" "sudo sh deploy/publish-panel $domain"
next_step "Remove the route again" "sudo sh deploy/publish-panel --off"
