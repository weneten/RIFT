#!/bin/sh
# Set up a reverse proxy in Docker on the RIFT server, for websites with HTTPS (`rift add site`):
#
#   sudo sh deploy/setup-proxy traefik|caddy|npm [--email ADDRESS] [--migrate] [--yes]
#
#   traefik   Traefik (/opt/rift-traefik); certificates from Let's Encrypt
#   caddy     Caddy (/opt/rift-caddy); certificates from Let's Encrypt
#   npm       Nginx Proxy Manager (/opt/rift-npm), with its web interface on 127.0.0.1:81;
#             certificates from Let's Encrypt
#
#   --email ADDRESS   address for Let's Encrypt (expiry notices), stored as
#                     RIFT_LETSENCRYPT_EMAIL in .env; for npm also its admin login (required)
#   --migrate         switch from another proxy of this script: stop it, set up this one and
#                     move every site of `rift add site` to it (back to the old one if the new
#                     one cannot be set up)
#   --yes             do not ask
#
# Each one is set up the way `rift add site` expects it, so the next step is
# `rift add site AGENT DOMAIN PORT`. Ports 80 and 443 must be free, held by the same proxy, or
# with --migrate held by another proxy of this script. Safe to run again: settings are kept.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
env_file=$repo_dir/.env
traefik_image=traefik:v3.3
caddy_image=caddy:2.8-alpine
npm_image=jc21/nginx-proxy-manager:2.17.0
site_helper=/usr/local/lib/rift/rift-site
# The Docker network of the proxy has a fixed address range, so the web panel can trust it
# (deploy/publish-panel puts it into RIFT_WEBPANEL_PROXIES). RIFT_PROXY_SUBNET in .env changes it.
default_subnet=10.255.13.0/24

fail() {
  printf 'rift: %s\n' "$*" >&2
  exit 1
}

proxy=
email=
assume_yes=
migrate=
while [ "$#" -gt 0 ]; do
  case $1 in
    traefik | caddy | npm) [ -z "$proxy" ] || fail "name one proxy"; proxy=$1; shift ;;
    nginx) fail "plain Nginx is not set up by this script; use npm (Nginx Proxy Manager), or your own Nginx as in the README" ;;
    --email) [ "$#" -ge 2 ] || fail "--email needs a value"; email=$2; shift 2 ;;
    --migrate) migrate=1; shift ;;
    --yes | -y) assume_yes=1; shift ;;
    -h | --help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "unknown argument $1 (see sh deploy/setup-proxy --help)" ;;
  esac
done
[ -n "$proxy" ] || fail "name the proxy: sh deploy/setup-proxy traefik|caddy|npm"
[ "$(id -u)" -eq 0 ] || fail "run as root: sudo sh deploy/setup-proxy $proxy"
[ -f "$env_file" ] && grep -Eq '^COMPOSE_PROFILES=server' "$env_file" \
  || fail "no RIFT server here ($env_file); run sudo sh deploy/setup-server first"
command -v rift > /dev/null 2>&1 && [ -x "$site_helper" ] \
  || fail "the rift command and its site helper are missing; run sudo sh deploy/install-cli first"
docker info > /dev/null 2>&1 || fail "Docker does not answer; is the docker service running?"

interactive=
if [ -z "$assume_yes" ] && [ -t 0 ] && [ -t 1 ]; then
  interactive=1
fi

subnet=$(sed -n 's/^RIFT_PROXY_SUBNET=//p' "$env_file" | tail -n 1)
subnet=${subnet:-$default_subnet}
printf '%s\n' "$subnet" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$' \
  || fail "RIFT_PROXY_SUBNET is not an IPv4 network like 10.255.13.0/24: $subnet"

case $proxy in
  traefik) dir=/opt/rift-traefik; container=traefik ;;
  caddy) dir=/opt/rift-caddy; container=rift-caddy ;;
  npm) dir=/opt/rift-npm; container=rift-npm ;;
esac

# ---------- ports 80 and 443 ----------
# Who holds a port: a container name, or the process name of a host program.
holder() {
  port=$1
  name=$(docker ps --format '{{.Names}} {{.Ports}}' 2> /dev/null \
    | awk -v p=":$port->" 'index($0, p) {print $1; exit}')
  if [ -n "$name" ]; then
    printf 'container %s\n' "$name"
    return
  fi
  ss -Hltnp "sport = :$port" 2> /dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | head -n 1
}
# The directory of a proxy container this script set up, or nothing.
our_dir() {
  wd=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$1" 2> /dev/null || true)
  case $wd in
    /opt/rift-traefik | /opt/rift-caddy | /opt/rift-npm) printf '%s\n' "$wd" ;;
  esac
}
old_dir=
for port in 80 443; do
  held=$(holder "$port")
  if [ -z "$held" ] || [ "$held" = "container $container" ]; then
    continue
  fi
  other=
  case $held in
    "container "*) other=$(our_dir "${held#container }") ;;
  esac
  if [ -n "$other" ] && [ -n "$migrate" ]; then
    old_dir=$other
  elif [ -n "$other" ]; then
    fail "port $port is held by $held ($other). To switch to $proxy and move every site: sudo sh deploy/setup-proxy $proxy --migrate"
  else
    fail "port $port is held by $held. Stop it first (and disable it), then run this again; with --migrate the sites of rift add site move to $proxy too. Or keep it and point 'rift proxy' at it (see the README, Publish websites with HTTPS)"
  fi
done

# Sites of `rift add site` that use another proxy than this one.
other_sites=$(python3 -c '
import json, os, sys
path = os.environ.get("RIFT_SITE_STATE", "/var/lib/rift-site/sites.json")
try:
    state = json.load(open(path))
except (OSError, ValueError):
    state = {}
routes = list((state.get("sites") or {}).values())
if state.get("panel"):
    routes.append(state["panel"])  # the web panel route of deploy/publish-panel
print(sum(1 for route in routes if route.get("proxy") != sys.argv[1]))
' "$proxy")

# ---------- the e-mail address ----------
if [ -z "$email" ]; then
  email=$(sed -n 's/^RIFT_LETSENCRYPT_EMAIL=//p' "$env_file" | tail -n 1)
fi
if [ -z "$email" ] && [ "$proxy" = npm ]; then
  email=$(sed -n 's/^RIFT_NPM_EMAIL=//p' "$env_file" | tail -n 1)
fi
if [ -z "$email" ] && [ -n "$interactive" ]; then
  printf 'E-mail address for Let'"'"'s Encrypt (expiry notices%s): ' \
    "$([ "$proxy" = npm ] && echo '; also the Nginx Proxy Manager login' || echo '; Enter for none')" > /dev/tty
  read -r email < /dev/tty || email=
fi
[ -n "$email" ] || [ "$proxy" != npm ] || fail "npm needs --email: it is the login of its web interface and its Let's Encrypt address"
if [ -n "$email" ] && ! printf '%s\n' "$email" | grep -Eq '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'; then
  fail "not an e-mail address: $email"
fi

if [ -n "$interactive" ]; then
  if [ -n "$old_dir" ]; then
    printf 'This stops the proxy in %s; websites are down until %s serves them.\n' "$old_dir" "$proxy" > /dev/tty
  fi
  if [ -n "$migrate" ] && [ "$other_sites" -gt 0 ]; then
    printf '%s site(s) move to %s and get new certificates.\n' "$other_sites" "$proxy" > /dev/tty
  fi
  printf 'Set up %s in Docker on ports 80 and 443 (%s)? [Y/n]: ' "$proxy" "$dir" > /dev/tty
  read -r reply < /dev/tty || reply=
  case ${reply:-y} in [yY]*) ;; *) fail "nothing changed" ;; esac
fi

umask 077
. "$script_dir/env.sh"
server_env_changed=
if [ -n "$email" ] && ! grep -qx "RIFT_LETSENCRYPT_EMAIL=$email" "$env_file"; then
  put_env RIFT_LETSENCRYPT_EMAIL "$email"
  server_env_changed=1
fi
umask 022

# ---------- the proxy ----------
# Starts the Compose project in $dir. A network from before with another address range is
# replaced (docker compose cannot change it in place).
compose_up() {
  network="$(basename "$dir")_default"
  current=$(docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' "$network" 2> /dev/null || true)
  current=$(printf '%s' "$current" | tr -d ' ')
  if [ -n "$current" ] && [ "$current" != "$subnet" ]; then
    (cd "$dir" && docker compose down)
  fi
  (cd "$dir" && docker compose up -d)
}
setup_traefik() {
  mkdir -p "$dir/dynamic" "$dir/letsencrypt"
  chmod 700 "$dir/letsencrypt"
  acme=
  if [ -n "$email" ]; then
    acme="      - --certificatesresolvers.myresolver.acme.email=$email
"
  fi
  cat > "$dir/compose.yml" << EOF
# Written by deploy/setup-proxy for 'rift add site', which writes one file per site into
# ./dynamic. Entry points web and websecure and the resolver myresolver are what it uses.
services:
  traefik:
    image: $traefik_image
    container_name: traefik
    restart: unless-stopped
    command:
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --providers.file.directory=/dynamic
      - --providers.file.watch=true
$acme      - --certificatesresolvers.myresolver.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.myresolver.acme.httpchallenge.entrypoint=web
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./dynamic:/dynamic:ro
      - ./letsencrypt:/letsencrypt
networks:
  default:
    ipam:
      config:
        - subnet: $subnet
EOF
  compose_up
  rift proxy traefik > /dev/null
}

setup_caddy() {
  mkdir -p "$dir/caddy/rift-sites" "$dir/data" "$dir/config"
  caddyfile=$dir/caddy/Caddyfile
  if [ ! -s "$caddyfile" ]; then
    {
      echo "# Written by deploy/setup-proxy. 'rift add site' writes one file per site into"
      echo "# rift-sites next to this file; add your own sites below."
      if [ -n "$email" ]; then
        printf '{\n\temail %s\n}\n\n' "$email"
      fi
      echo "import /etc/caddy/rift-sites/*.caddy"
    } > "$caddyfile"
  elif ! grep -q '^import /etc/caddy/rift-sites/\*\.caddy' "$caddyfile"; then
    printf '\n# Added by deploy/setup-proxy for rift add site.\nimport /etc/caddy/rift-sites/*.caddy\n' >> "$caddyfile"
  fi
  cat > "$dir/compose.yml" << EOF
# Written by deploy/setup-proxy for 'rift add site', which writes one file per site into
# ./caddy/rift-sites and reloads Caddy with docker exec. Edit ./caddy/Caddyfile for your own sites.
services:
  caddy:
    image: $caddy_image
    container_name: rift-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy:/etc/caddy:ro
      - ./data:/data
      - ./config:/config
networks:
  default:
    ipam:
      config:
        - subnet: $subnet
EOF
  docker run --rm -v "$dir/caddy:/etc/caddy:ro" "$caddy_image" \
    caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile > /dev/null 2>&1 \
    || fail "$caddyfile does not validate; check it with: docker run --rm -v $dir/caddy:/etc/caddy:ro $caddy_image caddy validate --config /etc/caddy/Caddyfile"
  compose_up
  docker exec rift-caddy caddy reload --config /etc/caddy/Caddyfile > /dev/null 2>&1 || true
  rift proxy caddy --container rift-caddy --sites-dir "$dir/caddy/rift-sites" > /dev/null
}

setup_npm() {
  mkdir -p "$dir/data" "$dir/letsencrypt"
  # The admin login: created by Nginx Proxy Manager on its first start, used by
  # 'rift add site' through its API. An existing one is kept.
  password=$(sed -n 's/^RIFT_NPM_PASSWORD=//p' "$env_file" | tail -n 1)
  if [ -z "$password" ]; then
    password=$(head -c 24 /dev/urandom | base64 | tr -d '/+=\n' | cut -c 1-24)
  fi
  umask 077
  put_env RIFT_NPM_EMAIL "$email"
  put_env RIFT_NPM_PASSWORD "$password"
  printf 'INITIAL_ADMIN_EMAIL=%s\nINITIAL_ADMIN_PASSWORD=%s\n' "$email" "$password" > "$dir/admin.env"
  umask 022
  server_env_changed=1
  # Its Nginx listens on [::] too, which fails on a kernel without IPv6.
  no_ipv6=
  if [ ! -e /proc/net/if_inet6 ]; then
    no_ipv6='    environment:
      DISABLE_IPV6: "true"
'
  fi
  cat > "$dir/compose.yml" << EOF
# Written by deploy/setup-proxy for 'rift add site', which creates one proxy host per site
# through the API on port 81. The web interface listens on this server only: open it through
# an SSH tunnel (ssh -L 8181:127.0.0.1:81 ...) and log in with RIFT_NPM_EMAIL and
# RIFT_NPM_PASSWORD from the RIFT .env. admin.env only sets up that login on the first start.
services:
  npm:
    image: $npm_image
    container_name: rift-npm
    restart: unless-stopped
    env_file: ./admin.env
${no_ipv6}    ports:
      - "80:80"
      - "443:443"
      - "127.0.0.1:81:81"
    volumes:
      - ./data:/data
      - ./letsencrypt:/etc/letsencrypt
networks:
  default:
    ipam:
      config:
        - subnet: $subnet
EOF
  compose_up
  printf 'Waiting for Nginx Proxy Manager'
  i=0
  until curl -fsS -o /dev/null http://127.0.0.1:81/api/ 2> /dev/null; do
    i=$((i + 1))
    [ "$i" -lt 60 ] || { echo; fail "Nginx Proxy Manager does not answer on 127.0.0.1:81; see: docker logs rift-npm"; }
    printf '.'
    sleep 2
  done
  echo
  body=$(printf '{"identity":"%s","secret":"%s"}' "$email" "$password")
  if ! curl -fsS -o /dev/null -H 'Content-Type: application/json' -d "$body" http://127.0.0.1:81/api/tokens; then
    fail "Nginx Proxy Manager does not accept the login from .env (it had an admin before). Set RIFT_NPM_EMAIL and RIFT_NPM_PASSWORD in $env_file to its admin login"
  fi
  rift proxy npm > /dev/null
}

# With --migrate the old proxy stops first. If the new one cannot be set up, it runs again,
# unchanged: its configuration is only removed once the sites have moved.
switched=
restore_old() {
  if [ -n "$old_dir" ] && [ -z "$switched" ]; then
    echo "rift: $proxy could not be set up; starting the proxy in $old_dir again" >&2
    if [ -f "$dir/compose.yml" ]; then
      (cd "$dir" && docker compose down > /dev/null 2>&1) || true
    fi
    (cd "$old_dir" && docker compose up -d > /dev/null 2>&1) || echo "rift: could not start it; run: cd $old_dir && docker compose up -d" >&2
  fi
}
trap restore_old EXIT
if [ -n "$old_dir" ]; then
  echo "Stopping the proxy in $old_dir"
  (cd "$old_dir" && docker compose down)
fi

echo "Setting up $proxy"
"setup_$proxy"
switched=1
if [ -n "$server_env_changed" ]; then
  # The server container passes these settings to the site helper.
  (cd "$repo_dir" && docker compose up -d > /dev/null)
fi

migrate_failed=
if [ -n "$migrate" ] && [ "$other_sites" -gt 0 ]; then
  echo "Moving the sites to $proxy"
  "$site_helper" migrate-sites "$proxy" || migrate_failed=1
fi

echo
echo "$proxy runs in Docker ($dir) and is the proxy for rift add site. Next:"
echo "  1. Point the domain's A record (and AAAA, if you publish IPv6) at this server."
echo "  2. Open TCP 80 and 443 in your cloud firewall or security group."
echo "  3. rift add site AGENT DOMAIN PORT     for example: rift add site node1 app.example.net 8080"
if [ "$proxy" = npm ]; then
  echo "Web interface: on this server at http://127.0.0.1:81, from elsewhere through an SSH tunnel"
  echo "  (ssh -L 8181:127.0.0.1:81 root@SERVER, then http://127.0.0.1:8181). Login: RIFT_NPM_EMAIL and"
  echo "  RIFT_NPM_PASSWORD in $env_file. Nginx Proxy Manager logs that password once on its first start;"
  echo "  change it in the interface and in .env together if you want."
fi
if [ -z "$email" ]; then
  echo "Without an e-mail address Let's Encrypt cannot warn you before a certificate expires;"
  echo "run this again with --email to add one."
fi
if [ -n "$old_dir" ]; then
  echo "The old proxy is stopped; its files stay in $old_dir. Delete them once everything works."
fi
if [ -z "$migrate" ] && [ "$other_sites" -gt 0 ]; then
  echo "$other_sites site(s) still use another proxy. Move them with: sudo sh deploy/setup-proxy $proxy --migrate"
fi
if [ -n "$migrate_failed" ]; then
  exit 1
fi
