#!/bin/sh
# Set up a reverse proxy on the RIFT server for websites with HTTPS (`rift add site`):
#
#   sudo sh deploy/setup-proxy traefik|caddy|nginx [--email ADDRESS] [--yes]
#
#   traefik   Traefik in Docker (/opt/rift-traefik), certificates from Let's Encrypt
#   caddy     Caddy from the distribution (apt), certificates from Let's Encrypt by Caddy
#   nginx     Nginx and certbot from the distribution (apt); `rift add site` runs certbot
#
#   --email ADDRESS   address for Let's Encrypt (expiry notices); stored as
#                     RIFT_LETSENCRYPT_EMAIL in .env
#   --yes             do not ask
#
# Each one is set up the way `rift add site` expects it, so the next step is
# `rift add site AGENT DOMAIN PORT`. Ports 80 and 443 must be free (or held by the same proxy,
# set up by this script before). Caddy and Nginx need a Debian or Ubuntu host. Safe to run again.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
env_file=$repo_dir/.env
traefik_dir=/opt/rift-traefik
traefik_image=traefik:v3.3

fail() {
  printf 'rift: %s\n' "$*" >&2
  exit 1
}

proxy=
email=
assume_yes=
while [ "$#" -gt 0 ]; do
  case $1 in
    traefik | caddy | nginx) [ -z "$proxy" ] || fail "name one proxy"; proxy=$1; shift ;;
    --email) [ "$#" -ge 2 ] || fail "--email needs a value"; email=$2; shift 2 ;;
    --yes | -y) assume_yes=1; shift ;;
    -h | --help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "unknown argument $1 (see sh deploy/setup-proxy --help)" ;;
  esac
done
[ -n "$proxy" ] || fail "name the proxy: sh deploy/setup-proxy traefik|caddy|nginx"
[ "$(id -u)" -eq 0 ] || fail "run as root: sudo sh deploy/setup-proxy $proxy"
[ -f "$env_file" ] && grep -Eq '^COMPOSE_PROFILES=server' "$env_file" \
  || fail "no RIFT server here ($env_file); run sudo sh deploy/setup-server first"
command -v rift > /dev/null 2>&1 && [ -x /usr/local/lib/rift/rift-site ] \
  || fail "the rift command and its site helper are missing; run sudo sh deploy/install-cli first"

interactive=
if [ -z "$assume_yes" ] && [ -t 0 ] && [ -t 1 ]; then
  interactive=1
fi

# ---------- ports 80 and 443 ----------
# Who holds a port: a container name, or the process name of a host program.
holder() {
  port=$1
  if command -v docker > /dev/null 2>&1; then
    name=$(docker ps --format '{{.Names}} {{.Ports}}' 2> /dev/null \
      | awk -v p=":$port->" 'index($0, p) {print $1; exit}')
    if [ -n "$name" ]; then
      printf 'container %s\n' "$name"
      return
    fi
  fi
  ss -Hltnp "sport = :$port" 2> /dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | head -n 1
}
ours() {
  # Whether the holder is the proxy this script sets up (then it is set up again).
  case $proxy:$1 in
    traefik:"container traefik" | caddy:caddy | nginx:nginx) return 0 ;;
    *) return 1 ;;
  esac
}
for port in 80 443; do
  held=$(holder "$port")
  if [ -n "$held" ] && ! ours "$held"; then
    fail "port $port is held by $held. Stop it first, or keep it and point 'rift proxy' at it (see the README, Publish websites with HTTPS)"
  fi
done

if [ "$proxy" != traefik ]; then
  command -v apt-get > /dev/null 2>&1 \
    || fail "$proxy is installed from the distribution here, which needs apt (Debian or Ubuntu). Use traefik, or set $proxy up by hand as in the README"
fi

# ---------- the Let's Encrypt address ----------
if [ -z "$email" ]; then
  email=$(sed -n 's/^RIFT_LETSENCRYPT_EMAIL=//p' "$env_file" | tail -n 1)
fi
if [ -z "$email" ] && [ -n "$interactive" ]; then
  printf 'E-mail address for Let'"'"'s Encrypt (expiry notices; Enter for none): ' > /dev/tty
  read -r email < /dev/tty || email=
fi
if [ -n "$email" ] && ! printf '%s\n' "$email" | grep -Eq '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'; then
  fail "not an e-mail address: $email"
fi

if [ -n "$interactive" ]; then
  printf 'Set up %s on ports 80 and 443%s? [Y/n]: ' "$proxy" "${email:+ with $email for Let's Encrypt}" > /dev/tty
  read -r reply < /dev/tty || reply=
  case ${reply:-y} in [yY]*) ;; *) fail "nothing changed" ;; esac
fi

umask 077
. "$script_dir/env.sh"
if [ -n "$email" ]; then
  put_env RIFT_LETSENCRYPT_EMAIL "$email"
  # The server container passes it to the site helper (certbot for Nginx).
  (cd "$repo_dir" && docker compose up -d > /dev/null)
fi
umask 022

# ---------- the proxy ----------
setup_traefik() {
  mkdir -p "$traefik_dir/dynamic" "$traefik_dir/letsencrypt"
  chmod 700 "$traefik_dir/letsencrypt"
  acme=
  if [ -n "$email" ]; then
    acme="      - --certificatesresolvers.myresolver.acme.email=$email
"
  fi
  cat > "$traefik_dir/compose.yml" << EOF
# Written by deploy/setup-proxy for 'rift add site', which writes one file per site into
# ./dynamic. Entry points web and websecure and the resolver myresolver are what it uses.
services:
  traefik:
    image: $traefik_image
    container_name: traefik
    restart: unless-stopped
    command:
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
      - --providers.file.directory=/dynamic
      - --providers.file.watch=true
$acme      - --certificatesresolvers.myresolver.acme.storage=/letsencrypt/acme.json
      - --certificatesresolvers.myresolver.acme.httpchallenge.entrypoint=web
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./dynamic:/dynamic:ro
      - ./letsencrypt:/letsencrypt
EOF
  (cd "$traefik_dir" && docker compose up -d)
}

setup_caddy() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y caddy > /dev/null
  mkdir -p /etc/caddy/rift-sites
  caddyfile=/etc/caddy/Caddyfile
  # The package's example serves a placeholder page on :80; replace only that one.
  if [ ! -s "$caddyfile" ] || grep -q 'root \* /usr/share/caddy' "$caddyfile"; then
    [ -s "$caddyfile" ] && cp "$caddyfile" "$caddyfile.rift-bak"
    {
      echo "# Written by deploy/setup-proxy. 'rift add site' writes one file per site into"
      echo "# /etc/caddy/rift-sites; add your own sites below."
      if [ -n "$email" ]; then
        printf '{\n\temail %s\n}\n\n' "$email"
      fi
      echo "import /etc/caddy/rift-sites/*.caddy"
    } > "$caddyfile"
  elif ! grep -q '^import /etc/caddy/rift-sites/\*\.caddy' "$caddyfile"; then
    printf '\n# Added by deploy/setup-proxy for rift add site.\nimport /etc/caddy/rift-sites/*.caddy\n' >> "$caddyfile"
  fi
  caddy validate --config "$caddyfile" --adapter caddyfile > /dev/null 2>&1 \
    || fail "$caddyfile does not validate; check it with: caddy validate --config $caddyfile"
  systemctl enable --now caddy > /dev/null 2>&1
  systemctl reload caddy || systemctl restart caddy
}

setup_nginx() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y nginx certbot python3-certbot-nginx > /dev/null
  mkdir -p /etc/nginx/rift-sites
  printf '# Written by deploy/setup-proxy: the sites of rift add site.\ninclude /etc/nginx/rift-sites/*.conf;\n' \
    > /etc/nginx/conf.d/rift-sites.conf
  nginx -t > /dev/null 2>&1 || fail "nginx -t fails; check the configuration with: nginx -t"
  systemctl enable --now nginx > /dev/null 2>&1
  systemctl reload nginx || systemctl restart nginx
}

echo "Setting up $proxy"
if [ "$proxy" != traefik ]; then
  DEBIAN_FRONTEND=noninteractive apt-get update > /dev/null
fi
"setup_$proxy"

# The firewall on this host: RIFT opens its own ports, a proxy on the host needs 80 and 443.
# (Docker publishes Traefik's ports past UFW.)
if [ "$proxy" != traefik ] && command -v ufw > /dev/null 2>&1 && ufw status 2> /dev/null | grep -q '^Status: active'; then
  ufw allow 80/tcp > /dev/null
  ufw allow 443/tcp > /dev/null
  echo "UFW: allowed TCP 80 and 443"
fi

# Make it the helper's default proxy.
rift proxy "$proxy" > /dev/null

echo
echo "$proxy is set up for websites. Next:"
echo "  1. Point the domain's A record (and AAAA, if you publish IPv6) at this server."
echo "  2. Open TCP 80 and 443 in your cloud firewall or security group."
echo "  3. rift add site AGENT DOMAIN PORT     for example: rift add site node1 app.example.net 8080"
if [ -z "$email" ]; then
  echo "Without an e-mail address Let's Encrypt cannot warn you before a certificate expires;"
  echo "run this again with --email to add one."
fi
