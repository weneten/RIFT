PROXIES = ("traefik", "caddy", "nginx", "npm")
HOST_RE = re.compile(
    r"^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$",
    re.IGNORECASE,
)
AGENT_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SS_PROCESS = re.compile(r'\(\("([^"]+)"')
STATE_PATH = Path(os.environ.get("RIFT_SITE_STATE", "/var/lib/rift-site/sites.json"))


class SiteError(Exception):
    pass


def valid_host(host):
    return bool(HOST_RE.fullmatch(host))


def valid_agent(agent):
    return bool(AGENT_RE.fullmatch(agent))


def router_name(host):
    cleaned = re.sub(r"[^a-z0-9]+", "-", host.lower()).strip("-")
    return f"rift-{cleaned}"[:60]


MAX_ALLOW_FROM = 64


def parse_allow_from(values):
    """Addresses or networks from --allow-from values (commas or spaces between them).

    A bare address means that host. Host bits are cleared, duplicates dropped, order kept.
    Returns the networks as strings, for example ["203.0.113.7/32", "198.51.100.0/24"].
    """
    nets = []
    for value in values:
        if not isinstance(value, str):
            raise SiteError("allow_from entries must be strings")
        for word in re.split(r"[\s,]+", value.strip()):
            if not word:
                continue
            try:
                net = str(ipaddress.ip_network(word, strict=False))
            except ValueError:
                raise SiteError(
                    f"{word!r} is not an address or network like 203.0.113.7 or 198.51.100.0/24"
                ) from None
            if net not in nets:
                nets.append(net)
    if len(nets) > MAX_ALLOW_FROM:
        raise SiteError(f"--allow-from takes at most {MAX_ALLOW_FROM} addresses or networks")
    return nets


def allocate_port(used, low, high):
    for port in range(low, high + 1):
        if port not in used:
            return port
    raise SiteError(f"no free listen port in {low}-{high}")


def render_traefik(host, url, resolver, http_entry, https_entry, allow_from=(), major=3):
    name = router_name(host)
    # Traefik 3 renamed ipWhiteList to ipAllowList; both answer other clients with 403.
    uses = f"      middlewares:\n        - {name}-allow\n" if allow_from else ""
    text = (
        "http:\n"
        "  routers:\n"
        f"    {name}-web:\n"
        f"      rule: Host(`{host}`)\n"
        "      entryPoints:\n"
        f"        - {http_entry}\n"
        f"{uses}"
        f"      service: {name}\n"
        f"    {name}-websecure:\n"
        f"      rule: Host(`{host}`)\n"
        "      entryPoints:\n"
        f"        - {https_entry}\n"
        "      tls:\n"
        f"        certResolver: {resolver}\n"
        f"{uses}"
        f"      service: {name}\n"
    )
    if allow_from:
        kind = "ipWhiteList" if major == 2 else "ipAllowList"
        text += "  middlewares:\n" f"    {name}-allow:\n" f"      {kind}:\n" "        sourceRange:\n"
        text += "".join(f'          - "{net}"\n' for net in allow_from)
    return text + (
        "  services:\n"
        f"    {name}:\n"
        "      loadBalancer:\n"
        "        servers:\n"
        f"          - url: {url}\n"
    )


def render_caddy(host, url, allow_from=()):
    backend = url[7:] if url.startswith("http://") else url
    guard = ""
    if allow_from:
        # `respond` runs before `reverse_proxy` in Caddy's directive order.
        guard = (
            f"    @rift_denied not remote_ip {' '.join(allow_from)}\n"
            "    respond @rift_denied 403\n"
        )
    return f"{host} {{\n{guard}    reverse_proxy {backend}\n}}\n"


def nginx_access(allow_from, indent):
    """allow/deny lines; inside `location /` so certbot's ACME challenge location stays open."""
    if not allow_from:
        return ""
    lines = [f"allow {net};" for net in allow_from] + ["deny all;"]
    return "".join(f"{indent}{line}\n" for line in lines)


def render_nginx(host, url, allow_from=()):
    return (
        "server {\n"
        "    listen 80;\n"
        f"    server_name {host};\n"
        "    location / {\n"
        f"{nginx_access(allow_from, '        ')}"
        f"        proxy_pass {url};\n"
        "        proxy_set_header Host $host;\n"
        "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n"
        "        proxy_set_header X-Forwarded-Proto $scheme;\n"
        "    }\n"
        "}\n"
    )


def publishes_443(ports):
    return bool(re.search(r"(?:0\.0\.0\.0|\[::\]|:::):443->", ports or ""))


def proxy_kind(name, image):
    blob = f"{name} {image}".lower()
    # Nginx Proxy Manager runs nginx inside; recognise it before the plain nginx match.
    if "proxy-manager" in blob or re.search(r"\bnpm\b", blob):
        return "npm"
    hits = [kind for kind in PROXIES if kind in blob]
    if len(hits) == 1:
        return hits[0]
    return None


def listeners_from_ss(text):
    found = []
    for line in text.splitlines():
        if not re.search(r"(?:^|\s)\[?(?:::|[0-9.]+|::)\]?:443(?:\s|$)", line):
            continue
        match = SS_PROCESS.search(line)
        if match:
            found.append(match.group(1))
    return found


def containers_from_ps(text):
    rows = []
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            rows.append({"name": parts[0], "image": parts[1], "ports": parts[2]})
    return rows


def edge_holders(containers, host_processes):
    host_kinds = []
    for process in host_processes:
        kind = proxy_kind(process, "")
        if kind and kind not in host_kinds and process != "docker-proxy":
            host_kinds.append(kind)
    if host_kinds:
        return host_kinds
    found = []
    for container in containers:
        if not publishes_443(container.get("ports", "")):
            continue
        kind = proxy_kind(container.get("name", ""), container.get("image", ""))
        if kind and kind not in found:
            found.append(kind)
    return found


def require_edge(wanted, containers, host_processes):
    holders = edge_holders(containers, host_processes)
    if holders == [wanted]:
        return
    if not holders:
        raise SiteError(f"{wanted} is not listening on port 443")
    if len(holders) == 1:
        raise SiteError(f"{holders[0]} holds port 443, not {wanted}")
    raise SiteError(f"{' and '.join(holders)} hold port 443, not only {wanted}")


def public_ip_from_toml(text):
    match = re.search(r'public_ips\s*=\s*\[\s*"([^"]+)"', text)
    return match.group(1) if match else ""


def addresses_from_env(value):
    if not value:
        return []
    found = []
    for part in value.split(","):
        address = part.strip().strip('"').strip("'")
        if address:
            found.append(address)
    return found


def require_ip(address):
    try:
        ipaddress.ip_address(address)
    except ValueError:
        raise SiteError(
            "RIFT_PUBLIC_IPS must be the address on the VPS network interface, not a DNS name"
        ) from None
    return address


def resolve_public_ip(toml_text, env_value):
    # The server uses RIFT_PUBLIC_IPS from .env when it is set, and the TOML list otherwise.
    # The proxy reaches RIFT through a local hop, so one address suffices for every client
    # family: the first IPv4 address, or the first address when there is no IPv4.
    from_env = addresses_from_env(env_value)
    ipv4 = [a for a in from_env if ":" not in a]
    address = (ipv4 or from_env or [public_ip_from_toml(toml_text)])[0]
    if not address:
        raise SiteError(
            "RIFT_PUBLIC_IPS is missing from .env, and public_ips is missing from the RIFT config"
        )
    return require_ip(address)


def read_server_public_ip(container="rift-server", config_path="/etc/rift/config.toml"):
    completed = subprocess.run(
        ["docker", "exec", container, "printenv", "RIFT_PUBLIC_IPS"],
        text=True,
        capture_output=True,
        check=False,
    )
    env_value = completed.stdout if completed.returncode == 0 else ""
    config = run(["docker", "exec", container, "cat", config_path])
    return resolve_public_ip(config, env_value)


def listen_ports_of(forward):
    ports = forward.get("listen_ports") or {}
    start = int(ports.get("start", 0))
    end = int(ports.get("end", start))
    if start <= 0 or end < start:
        return set()
    return set(range(start, end + 1))


def traefik_layout(doc):
    obj = doc[0] if isinstance(doc, list) else doc
    args = obj.get("Args") or (obj.get("Config") or {}).get("Cmd") or []
    if isinstance(args, str):
        args = args.split()
    labels = (obj.get("Config") or {}).get("Labels") or {}
    source = None
    for mount in obj.get("Mounts") or []:
        dest = mount.get("Destination") or ""
        src = mount.get("Source") or ""
        if dest.endswith("dynamic_conf.yml") or src.endswith("dynamic_conf.yml"):
            source = src
    joined = " ".join(args)
    ready = "providers.file.directory=" in joined and "providers.file.filename=" not in joined
    # Host directory behind the watched file provider, so site files land where Traefik reads.
    directory = next(
        (a.split("=", 1)[1] for a in args if a.startswith("--providers.file.directory=")), None
    )
    dynamic_source = None
    for mount in obj.get("Mounts") or []:
        if directory and mount.get("Destination") == directory:
            dynamic_source = mount.get("Source") or None
    return {
        "ready": ready,
        "args": list(args),
        "dynamic_source": dynamic_source,
        "file_source": source,
        "working_dir": labels.get("com.docker.compose.project.working_dir"),
        "config_files": labels.get("com.docker.compose.project.config_files"),
        "service": labels.get("com.docker.compose.service") or "traefik",
    }


def migrate_compose(text):
    """Return (text, changed). changed is true only when the single-file provider was rewritten."""
    if "--providers.file.filename=/dynamic_conf.yml" not in text:
        return text, False
    output = []
    changed = False
    for line in text.splitlines(keepends=True):
        newline = "\n" if line.endswith("\n") else ""
        body = line[:-1] if newline else line
        if "--providers.file.filename=/dynamic_conf.yml" in body and body.lstrip().startswith("-"):
            indent = body[: len(body) - len(body.lstrip())]
            output.append(f'{indent}- "--providers.file.directory=/dynamic"{newline}')
            output.append(f'{indent}- "--providers.file.watch=true"{newline}')
            changed = True
            continue
        if "--providers.file.filename=/dynamic_conf.yml" in body:
            body = body.replace(
                "--providers.file.filename=/dynamic_conf.yml",
                "--providers.file.directory=/dynamic --providers.file.watch=true",
            )
            changed = True
        rewritten, did = _rewrite_volume(body)
        changed = changed or did
        output.append(rewritten + newline)
    return "".join(output), changed


DEFAULT_TRAEFIK_DIR = "/root/traefik/dynamic"
FILE_PROVIDER_ARGS = ("--providers.file.directory=/dynamic", "--providers.file.watch=true")


def _list_block(lines, start, key_indent):
    """Return (first_item, last_item) of the YAML list under lines[start], or None."""
    last = None
    for index in range(start + 1, len(lines)):
        line = lines[index]
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= key_indent and not stripped.startswith("-"):
            break
        if stripped.startswith("-"):
            last = index
        else:
            break
    return last


def add_file_provider(text, service, dynamic_dir):
    """Add a watched /dynamic file provider to a Compose service. Returns (text, changed)."""
    lines = text.split("\n")
    head = None
    for index, line in enumerate(lines):
        if line.strip() == f"{service}:" and line.startswith("  ") and not line.startswith("   "):
            head = index
            break
    if head is None:
        return text, False
    head_indent = len(lines[head]) - len(lines[head].lstrip())
    end = len(lines)
    for index in range(head + 1, len(lines)):
        line = lines[index]
        if line.strip() and not line.strip().startswith("#"):
            if len(line) - len(line.lstrip()) <= head_indent:
                end = index
                break

    def find_key(name):
        for index in range(head + 1, end):
            if lines[index].strip() == f"{name}:":
                return index
        return None

    def add_items(key, items):
        position = find_key(key)
        if position is None:
            return False
        last = _list_block(lines, position, len(lines[position]) - len(lines[position].lstrip()))
        if last is None:
            return False
        sample = lines[last]
        indent = sample[: len(sample) - len(sample.lstrip())]
        body = sample.strip()[1:].strip()
        quote = body[0] if body and body[0] in "\"'" else ""
        new = [f"{indent}- {quote}{item}{quote}" for item in items]
        lines[last + 1 : last + 1] = new
        return True

    if not add_items("command", FILE_PROVIDER_ARGS):
        return text, False
    # The command list grew, so re-find the service end before touching volumes.
    end += len(FILE_PROVIDER_ARGS)
    if not add_items("volumes", [f"{dynamic_dir}:/dynamic:ro"]):
        return text, False
    return "\n".join(lines), True


def _rewrite_volume(body):
    match = re.search(r'([\'"]?)(?P<src>\S*dynamic_conf\.yml):/dynamic_conf\.yml(?P<mode>:[a-z]+)?\1', body)
    if not match:
        return body, False
    source = match.group("src")
    mode = match.group("mode") or ":ro"
    parent = str(Path(source).parent).replace("\\", "/")
    replacement = f"{parent}/dynamic:/dynamic{mode}"
    return body[: match.start()] + replacement + body[match.end() :], True


