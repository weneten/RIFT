def load_state():
    if not STATE_PATH.exists():
        return None
    return json.loads(STATE_PATH.read_text(encoding="utf-8"))


def save_state(state):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE_PATH.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.replace(STATE_PATH)


def run(cmd, cwd=None):
    completed = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, check=False)
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "command failed").strip()
        raise SiteError(detail)
    return completed.stdout


def rift(state, *args):
    raw = run(
        [
            "docker",
            "exec",
            state["container"],
            "rift",
            "--config",
            state["rift_config"],
            "--json",
            *args,
        ]
    )
    return json.loads(raw) if raw.strip() else None


def capture_edge():
    ps = run(["docker", "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Ports}}"])
    ss = subprocess.run(
        ["ss", "-H", "-ltnp", "( sport = :443 )"],
        text=True,
        capture_output=True,
        check=False,
    )
    processes = listeners_from_ss(ss.stdout) if ss.returncode == 0 else []
    return containers_from_ps(ps), processes


def used_ports(state):
    used = set()
    for site in state["sites"].values():
        used.add(int(site["listen"]))
    listed = rift(state, "list", "forwards") or []
    for forward in listed:
        used.update(listen_ports_of(forward))
    return used


def service_url(state, listen):
    return f"http://{state['public_ip']}:{listen}"


def missing_agent_message(agent, detail):
    if "agent not found" in detail:
        return (
            f"agent {agent} has not finished enrollment. "
            "Wait until its status is active"
        )
    return detail


def parse_env_file(text):
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


SITE_ENV_FILE = Path(os.environ.get("RIFT_SITE_ENV", "/etc/rift/site.env"))


def site_setting(key, container="rift-server"):
    """Look a value up in the environment, then the server container (fed by .env), then site.env."""
    value = os.environ.get(key, "").strip()
    if value:
        return value
    try:
        completed = subprocess.run(
            ["docker", "exec", container, "printenv", key],
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        completed = None
    if completed is not None and completed.returncode == 0 and completed.stdout.strip():
        return completed.stdout.strip()
    if SITE_ENV_FILE.exists():
        return parse_env_file(SITE_ENV_FILE.read_text(encoding="utf-8")).get(key, "").strip()
    return ""


def letsencrypt_email(container="rift-server"):
    return site_setting("RIFT_LETSENCRYPT_EMAIL", container)


def request_certificate(container="rift-server"):
    """RIFT_REQUEST_CERTIFICATE: anything but false/0/no/off requests a certificate."""
    value = site_setting("RIFT_REQUEST_CERTIFICATE", container).lower()
    return value not in ("false", "0", "no", "off")


def certbot_command(host, email):
    command = ["certbot", "--nginx", "--non-interactive", "--agree-tos"]
    command += ["--email", email] if email else ["--register-unsafely-without-email"]
    return command + ["-d", host]


def npm_settings(state):
    settings = {"url": "http://127.0.0.1:81"}
    settings.update(state.get("npm") or {})
    settings["container"] = state.get("container", "rift-server")
    return settings


def npm_credentials(settings):
    container = settings["container"]
    email = site_setting("RIFT_NPM_EMAIL", container)
    password = site_setting("RIFT_NPM_PASSWORD", container)
    if not email or not password:
        raise SiteError(
            "set RIFT_NPM_EMAIL and RIFT_NPM_PASSWORD in the server .env "
            "(or /etc/rift/site.env) with the login of a Nginx Proxy Manager admin"
        )
    # NPM needs a contact address; fall back to the admin login when no other is set.
    return email, password, letsencrypt_email(container) or email


def npm_request(settings, method, path, body=None, token=None):
    data = json.dumps(body).encode("utf-8") if body is not None else None
    request = urllib.request.Request(
        settings["url"].rstrip("/") + "/api" + path, data=data, method=method
    )
    request.add_header("Content-Type", "application/json")
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")[:300]
        raise SiteError(
            f"Nginx Proxy Manager API {method} {path}: HTTP {error.code} {detail}"
        ) from None
    except (urllib.error.URLError, OSError) as error:
        raise SiteError(f"cannot reach Nginx Proxy Manager at {settings['url']}: {error}") from None
    return json.loads(raw) if raw.strip() else None


def npm_login(settings):
    email, password, le_email = npm_credentials(settings)
    reply = npm_request(settings, "POST", "/tokens", {"identity": email, "secret": password})
    if not reply or not reply.get("token"):
        raise SiteError("Nginx Proxy Manager login did not return a token")
    return reply["token"], le_email


def npm_host_payload(host, public_ip, listen, certificate_id, allow_from=()):
    secure = bool(certificate_id)
    return {
        "domain_names": [host],
        "forward_scheme": "http",
        "forward_host": public_ip,
        "forward_port": int(listen),
        "access_list_id": 0,
        "certificate_id": certificate_id,
        "ssl_forced": secure,
        "http2_support": secure,
        "hsts_enabled": False,
        "hsts_subdomains": False,
        "caching_enabled": False,
        "block_exploits": True,
        "allow_websocket_upgrade": True,
        "advanced_config": nginx_access(allow_from, ""),
        "meta": {"letsencrypt_agree": False, "dns_challenge": False},
        "locations": [],
    }


def npm_publish(state, host, listen, allow_from=(), target_host=None):
    """Creates or updates the Nginx Proxy Manager host for `host`, forwarding to
    `target_host` (default: the server's public address) and `listen`."""
    target_host = target_host or state["public_ip"]
    settings = npm_settings(state)
    token, le_email = npm_login(settings)
    hosts = npm_request(settings, "GET", "/nginx/proxy-hosts", token=token) or []
    current = next((h for h in hosts if host in (h.get("domain_names") or [])), None)
    certificate_id = int(current.get("certificate_id") or 0) if current else 0
    payload = npm_host_payload(host, target_host, listen, certificate_id, allow_from)
    if current:
        saved = npm_request(
            settings, "PUT", f"/nginx/proxy-hosts/{current['id']}", payload, token
        )
    else:
        saved = npm_request(settings, "POST", "/nginx/proxy-hosts", payload, token)
    host_id = saved["id"]
    if certificate_id:
        return {"host_id": host_id, "note": None}
    if not request_certificate(settings["container"]):
        note = (
            "RIFT_REQUEST_CERTIFICATE is false; the proxy host was created without TLS. "
            "Request a certificate in the Nginx Proxy Manager UI"
        )
        return {"host_id": host_id, "note": note}
    note = None
    try:
        certificate = npm_request(
            settings,
            "POST",
            "/nginx/certificates",
            {
                "provider": "letsencrypt",
                "domain_names": [host],
                "meta": {
                    "letsencrypt_email": le_email,
                    "letsencrypt_agree": True,
                    "dns_challenge": False,
                },
            },
            token,
        )
        secured = npm_host_payload(host, target_host, listen, int(certificate["id"]), allow_from)
        npm_request(settings, "PUT", f"/nginx/proxy-hosts/{host_id}", secured, token)
    except SiteError as error:
        note = f"the proxy host exists without TLS; certificate request failed: {error}"
    return {"host_id": host_id, "note": note}


NPM_CERTIFICATE_USERS = (
    "/nginx/proxy-hosts",
    "/nginx/redirection-hosts",
    "/nginx/dead-hosts",
    "/nginx/streams",
)


def npm_remove_certificate(settings, token, certificate_id, host):
    """Delete the certificate only if it is for this host alone and nothing else uses it."""
    certificate = npm_request(settings, "GET", f"/nginx/certificates/{certificate_id}", token=token)
    if (certificate or {}).get("domain_names") != [host]:
        return None
    for path in NPM_CERTIFICATE_USERS:
        for entry in npm_request(settings, "GET", path, token=token) or []:
            if int(entry.get("certificate_id") or 0) == certificate_id:
                return None
    npm_request(settings, "DELETE", f"/nginx/certificates/{certificate_id}", token=token)
    return None


def npm_remove(state, host_id, host):
    if not host_id:
        return None
    settings = npm_settings(state)
    token, _ = npm_login(settings)
    certificate_id = 0
    try:
        current = npm_request(settings, "GET", f"/nginx/proxy-hosts/{host_id}", token=token)
        certificate_id = int((current or {}).get("certificate_id") or 0)
        npm_request(settings, "DELETE", f"/nginx/proxy-hosts/{host_id}", token=token)
    except SiteError as error:
        if "HTTP 404" not in str(error):
            raise
    if not certificate_id:
        return None
    try:
        npm_remove_certificate(settings, token, certificate_id, host)
    except SiteError as error:
        return f"the proxy host was removed, but its certificate was kept: {error}"
    return None


def remove_site_config(state, site, host):
    if site["proxy"] == "npm":
        return npm_remove(state, site.get("npm_host_id"), host)
    site_path(state, site["proxy"], host).unlink(missing_ok=True)
    return None


def site_path(state, proxy, host):
    if proxy == "traefik":
        directory = Path(state["traefik"]["dynamic_dir"])
        suffix = ".yml"
    elif proxy == "caddy":
        directory = Path(state["caddy"]["sites_dir"])
        suffix = ".caddy"
    else:
        directory = Path(state["nginx"]["sites_dir"])
        suffix = ".conf"
    return directory / f"{host}{suffix}"


def render_site(state, proxy, host, listen, allow_from=()):
    url = service_url(state, listen)
    if proxy == "traefik":
        cfg = state["traefik"]
        return render_traefik(
            host,
            url,
            cfg["cert_resolver"],
            cfg["http_entrypoint"],
            cfg["https_entrypoint"],
            allow_from,
            int(cfg.get("major") or 3),
        )
    if proxy == "caddy":
        return render_caddy(host, url, allow_from)
    return render_nginx(host, url, allow_from)


def reload_proxy(state, proxy, host):
    if proxy in ("traefik", "npm"):
        return None
    if proxy == "caddy":
        run(state["caddy"]["reload"])
        return None
    run(state["nginx"]["test"])
    run(state["nginx"]["reload"])
    if not request_certificate(state["container"]):
        return "RIFT_REQUEST_CERTIFICATE is false; TLS was not requested"
    if shutil.which("certbot"):
        run(certbot_command(host, letsencrypt_email(state["container"])))
        return None
    return "certbot is not installed; TLS was not requested"


def traefik_major(doc):
    """Major version from the image tag (traefik:v2.11 -> 2); 3 when the tag does not say."""
    obj = doc[0] if isinstance(doc, list) else doc
    image = (obj.get("Config") or {}).get("Image") or ""
    match = re.search(r":v?(\d+)(?:[.\-@]|$)", image.split("/")[-1])
    return int(match.group(1)) if match else 3


def has_file_provider(layout):
    return "--providers.file." in " ".join(layout["args"])


def ensure_traefik_provider(state):
    raw = run(["docker", "inspect", "traefik"])
    inspected = json.loads(raw)
    state["traefik"]["major"] = traefik_major(inspected)
    layout = traefik_layout(inspected)
    if layout["ready"]:
        if layout["dynamic_source"]:
            state["traefik"]["dynamic_dir"] = layout["dynamic_source"]
        return None
    if not layout["config_files"] or not layout["working_dir"]:
        raise SiteError(
            "Traefik was not started with Docker Compose, so 'rift add site' cannot change its "
            "configuration. Add --providers.file.directory=/dynamic and "
            "--providers.file.watch=true with a /dynamic volume yourself."
        )
    compose_path = Path(layout["config_files"])
    original = compose_path.read_text(encoding="utf-8")
    if layout["file_source"]:
        source = Path(layout["file_source"])
        dynamic = Path(state["traefik"]["dynamic_dir"])
        dynamic.mkdir(parents=True, exist_ok=True)
        destination = dynamic / "ssh.yml"
        if source.exists() and not destination.exists():
            destination.write_text(source.read_text(encoding="utf-8"), encoding="utf-8")
        migrated, changed = migrate_compose(original)
    elif not has_file_provider(layout):
        # Docker-label-only Traefik: add a watched file provider next to the Compose project.
        if state["traefik"]["dynamic_dir"] == DEFAULT_TRAEFIK_DIR:
            state["traefik"]["dynamic_dir"] = str(Path(layout["working_dir"]) / "dynamic")
        dynamic = Path(state["traefik"]["dynamic_dir"])
        dynamic.mkdir(parents=True, exist_ok=True)
        migrated, changed = add_file_provider(original, layout["service"], str(dynamic))
    else:
        raise SiteError(
            "Traefik uses a file provider that 'rift add site' does not recognise. "
            "Point it at a watched /dynamic directory before 'rift add site' can add a name."
        )
    if not changed:
        raise SiteError(f"could not rewrite the Traefik file provider in {compose_path}")
    backup = compose_path.with_name(compose_path.name + ".rift-bak")
    created_backup = not backup.exists()
    if created_backup:
        backup.write_text(original, encoding="utf-8")
    compose_path.write_text(migrated, encoding="utf-8")
    run(
        ["docker", "compose", "-f", str(compose_path), "up", "-d", "--no-deps", layout["service"]],
        cwd=layout["working_dir"],
    )
    return backup_notice(compose_path, backup, created_backup)


def backup_notice(compose_path, backup, created):
    if created:
        return (
            f"Changed {compose_path} and recreated Traefik. The original is saved as {backup}.\n"
            "Once you have confirmed that everything works, it is safe to delete that backup."
        )
    return (
        f"Changed {compose_path} and recreated Traefik. An earlier backup from before "
        f"the first change by 'rift add site' is still at {backup}."
    )


def remove_forward(state, forward_id):
    if not forward_id:
        return
    try:
        rift(state, "remove", "forward", str(forward_id))
    except SiteError as error:
        if "not found" not in str(error):
            raise


def dns_hint(host, state):
    """Where the site's DNS record should point.

    RIFT_PUBLIC_IPS is the address RIFT binds to, which behind a cloud NAT is a private
    one. RIFT_PUBLIC_ENDPOINT is what agents dial from the internet, so prefer its address.
    """
    endpoint = site_setting("RIFT_PUBLIC_ENDPOINT", state["container"])
    if endpoint:
        try:
            ipaddress.ip_address(endpoint)
            return f"DNS: {host} -> {endpoint} (RIFT_PUBLIC_ENDPOINT)"
        except ValueError:
            pass
        try:
            address = socket.getaddrinfo(endpoint, None, socket.AF_INET)[0][4][0]
            return f"DNS: {host} -> {address} (address of {endpoint})"
        except OSError:
            pass
    return f"DNS: {host} -> {state['public_ip']}"


def dns_check(host, state):
    """The DNS hint, checked against what the name resolves to now, so it says what to do."""
    hint = dns_hint(host, state)
    target = hint.split(" -> ", 1)[1].split(" ", 1)[0]
    try:
        found = sorted({info[4][0] for info in socket.getaddrinfo(host, None, socket.AF_INET)})
    except OSError:
        found = []
    if target in found:
        return f"{hint}: ok"
    if not found:
        return f"{hint}: missing. Create this A record at your DNS provider; the site and its certificate work once it resolves."
    return f"{hint}: wrong, it resolves to {', '.join(found)}. Change the A record; the site and its certificate work once it points here."


SERVER_ID_PATH = "/var/lib/rift/wireguard.pub"


def read_server_id(state):
    """The server's identity: its WireGuard public key. A fresh state volume gets a new one."""
    completed = subprocess.run(
        ["docker", "exec", state["container"], "cat", SERVER_ID_PATH],
        text=True,
        capture_output=True,
        check=False,
    )
    return completed.stdout.strip() if completed.returncode == 0 else ""


def stale_hosts(stored_id, current_id, sites, forwards):
    """Hosts whose records belong to an earlier RIFT installation.

    A different server identity means a fresh installation: every record is stale. Records
    written before the identity was stored are stale when their forward no longer exists.
    """
    if not current_id or stored_id == current_id:
        return []
    if stored_id:
        return sorted(sites)
    return sorted(host for host, site in sites.items() if not site_forward_alive(site, forwards))


def reload_only(state, proxy):
    if proxy == "caddy":
        run(state["caddy"]["reload"])
    elif proxy == "nginx":
        run(state["nginx"]["test"])
        run(state["nginx"]["reload"])


def sync_installation(state):
    """Drop site records (and their proxy files) left over from an earlier installation."""
    sites = state.get("sites") or {}
    current = read_server_id(state)
    if not current or state.get("server_id") == current:
        return
    stored = state.get("server_id")
    forwards = (rift(state, "list", "forwards") or []) if sites and not stored else []
    reload = set()
    for host in stale_hosts(stored, current, sites, forwards):
        site = sites.pop(host)
        try:
            note = remove_site_config(state, site, host)
        except SiteError as error:
            note = f"its proxy configuration could not be removed: {error}"
        reload.add(site["proxy"])
        print(f"Removed {host}: it belonged to an earlier RIFT installation.")
        if note:
            print(note, file=sys.stderr)
    state["server_id"] = current
    if STATE_PATH.exists() or reload:
        save_state(state)
    for proxy in sorted(reload):
        try:
            reload_only(state, proxy)
        except SiteError as error:
            print(f"proxy reload: {error}", file=sys.stderr)


def command_purge():
    """Remove every generated proxy configuration and the helper's state. Never calls the container."""
    state = load_state()
    reload = set()
    for host, site in sorted(((state or {}).get("sites") or {}).items()):
        if site["proxy"] == "npm":
            print(f"Kept the Nginx Proxy Manager host {host}: delete it in the NPM interface.")
            continue
        path = site_path(state, site["proxy"], host)
        if path.exists():
            path.unlink()
            reload.add(site["proxy"])
            print(f"Removed {path}")
    for proxy in sorted(reload):
        try:
            reload_only(state, proxy)
        except SiteError as error:
            print(f"proxy reload: {error}", file=sys.stderr)
    if STATE_PATH.parent.exists():
        shutil.rmtree(STATE_PATH.parent)
        print(f"Removed {STATE_PATH.parent}")


def command_add(agent, host, port, proxy, allow_from=()):
    allow_from = parse_allow_from(list(allow_from))
    if not valid_agent(agent) or not valid_host(host):
        raise SiteError("agent or host is not a usable name")
    if not re.fullmatch(r"[0-9]{1,5}", port) or not 1 <= int(port) <= 65535:
        raise SiteError(
            f"PORT is the agent's port number, for example 8081 (got {port!r}); "
            "protocol suffixes like /tcp belong to `rift add forward`"
        )
    target = int(port)
    state = load_state()
    if state is None:
        state = default_state(read_server_public_ip())
    sync_installation(state)
    chosen = proxy or state.get("proxy") or "traefik"
    if chosen not in PROXIES:
        raise SiteError("proxy must be traefik, caddy, nginx, or npm")
    require_edge(chosen, *capture_edge())
    if chosen == "traefik":
        compose_notice = ensure_traefik_provider(state)
        if compose_notice:
            print(compose_notice)
    existing = state["sites"].get(host)
    # A forward removed by hand (rift remove forward) must be created again, not trusted.
    if (
        existing
        and int(existing["target"]) == target
        and existing.get("agent") == agent
        and existing.get("proxy") == chosen
        and site_forward_alive(existing, rift(state, "list", "forwards") or [])
    ):
        listen = int(existing["listen"])
        forward_id = existing.get("forward_id")
    else:
        if existing:
            remove_forward(state, existing.get("forward_id"))
        listen = int(existing["listen"]) if existing else allocate_port(
            used_ports(state), int(state["listen_min"]), int(state["listen_max"])
        )
        try:
            created = rift(
                state, "add", "forward", agent, f"{listen}:{target}/tcp", "--ingress", "local"
            )
        except SiteError as error:
            raise SiteError(missing_agent_message(agent, str(error))) from None
        forward_id = created["id"]
    warn_if_refused(state, forward_id)
    created_forward = not existing or existing.get("forward_id") != forward_id
    if existing and existing.get("proxy") != chosen:
        remove_site_config(state, existing, host)
    record = {
        "agent": agent,
        "target": target,
        "listen": listen,
        "proxy": chosen,
        "forward_id": forward_id,
    }
    if allow_from:
        record["allow_from"] = allow_from
    note = None
    try:
        if chosen == "npm":
            published = npm_publish(state, host, listen, allow_from)
            record["npm_host_id"] = published["host_id"]
            note = published["note"]
        else:
            path = site_path(state, chosen, host)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(render_site(state, chosen, host, listen, allow_from), encoding="utf-8")
        state["sites"][host] = record
        save_state(state)
    except Exception:
        if created_forward:
            remove_forward(state, forward_id)
        raise
    note = reload_proxy(state, chosen, host) or note
    print(f"https://{host}")
    if allow_from:
        print(f"Only {', '.join(allow_from)} may open it; the proxy answers everyone else with 403.")
    print(dns_check(host, state))
    if note:
        print(note)


# ---------------------------------------------------------------------------------------
# The web panel over HTTPS (deploy/publish-panel): a proxy route to the panel, which stays
# private: a proxy in Docker reaches it on the server's tunnel address, one on the host on
# loopback. state["panel"] remembers the route.

def proxy_in_container(state, proxy):
    if proxy in ("traefik", "npm"):
        return True
    if proxy == "caddy":
        return (state["caddy"].get("reload") or [""])[0] == "docker"
    return False


def panel_target(state, proxy, status):
    """(host, port) where `proxy` reaches the panel."""
    port = int(status.get("port") or 8090)
    if proxy_in_container(state, proxy):
        return str(status.get("server_ipv4") or "10.13.0.1"), port
    return "127.0.0.1", port


def render_traefik_panel(host, url, resolver, http_entry, https_entry):
    """Like a site, but plain HTTP only redirects to HTTPS: the panel takes no password there."""
    name = router_name(host)
    return (
        "http:\n"
        "  routers:\n"
        f"    {name}-web:\n"
        f"      rule: Host(`{host}`)\n"
        "      entryPoints:\n"
        f"        - {http_entry}\n"
        "      middlewares:\n"
        f"        - {name}-https\n"
        f"      service: {name}\n"
        f"    {name}-websecure:\n"
        f"      rule: Host(`{host}`)\n"
        "      entryPoints:\n"
        f"        - {https_entry}\n"
        "      tls:\n"
        f"        certResolver: {resolver}\n"
        f"      service: {name}\n"
        "  middlewares:\n"
        f"    {name}-https:\n"
        "      redirectScheme:\n"
        "        scheme: https\n"
        "        permanent: true\n"
        "  services:\n"
        f"    {name}:\n"
        "      loadBalancer:\n"
        "        servers:\n"
        f"          - url: {url}\n"
    )


def publish_panel_route(state, proxy, host, target):
    """Writes and loads the route; returns (npm_host_id or None, note or None)."""
    target_host, port = target
    if proxy == "npm":
        published = npm_publish(state, host, port, (), target_host)
        return published["host_id"], published["note"]
    url = f"http://{target_host}:{port}"
    if proxy == "traefik":
        cfg = state["traefik"]
        text = render_traefik_panel(
            host, url, cfg["cert_resolver"], cfg["http_entrypoint"], cfg["https_entrypoint"]
        )
    elif proxy == "caddy":
        text = render_caddy(host, url)
    else:
        text = render_nginx(host, url)
    path = site_path(state, proxy, host)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    try:
        return None, reload_proxy(state, proxy, host)
    except Exception:
        path.unlink(missing_ok=True)
        raise


def remove_panel_route(state, panel):
    """Removes the route of `panel` from its proxy; returns a note or None."""
    proxy, host = panel["proxy"], panel["host"]
    if proxy == "npm":
        try:
            return npm_remove(state, panel.get("npm_host_id"), host)
        except SiteError as error:
            return f"the Nginx Proxy Manager host for {host} could not be removed: {error}"
    site_path(state, proxy, host).unlink(missing_ok=True)
    try:
        reload_only(state, proxy)
    except SiteError as error:
        return f"{proxy} could not be reloaded: {error}"
    return None


def command_panel_route(args):
    """panel-route DOMAIN: the panel at https://DOMAIN through the default proxy.
    panel-route --off: remove that route."""
    state = load_state()
    if state is None:
        state = default_state(read_server_public_ip())
    sync_installation(state)
    if args == ["--off"]:
        panel = state.get("panel")
        if not panel:
            print("The panel has no route through the proxy.")
            return
        note = remove_panel_route(state, panel)
        del state["panel"]
        save_state(state)
        print(f"Removed the route https://{panel['host']} ({panel['proxy']}).")
        if note:
            print(f"Note: {note}")
        return
    if len(args) != 1 or not valid_host(args[0]):
        raise SiteError("usage: rift-site panel-route DOMAIN | --off")
    host = args[0]
    if host in state["sites"]:
        raise SiteError(f"{host} is a site of agent {state['sites'][host].get('agent')}; use another name for the panel")
    status = rift(state, "panel", "status") or {}
    if not status.get("enabled"):
        raise SiteError("the web panel is off; set RIFT_WEBPANEL=true in the server .env and recreate the container")
    proxy = state.get("proxy") or "traefik"
    require_edge(proxy, *capture_edge())
    if proxy == "traefik":
        notice = ensure_traefik_provider(state)
        if notice:
            print(notice)
    old = state.get("panel")
    if old and (old["host"] != host or old["proxy"] != proxy):
        note = remove_panel_route(state, old)
        if note:
            print(f"Note: {note}")
    target = panel_target(state, proxy, status)
    host_id, note = publish_panel_route(state, proxy, host, target)
    state["panel"] = {"host": host, "proxy": proxy}
    if host_id is not None:
        state["panel"]["npm_host_id"] = host_id
    save_state(state)
    print(f"https://{host} -> {proxy} -> panel at {target[0]}:{target[1]}")
    print(dns_check(host, state))
    if note:
        print(f"Note: {note}")


def command_migrate_sites(new):
    """Moves every site to proxy `new`, which must hold port 443 already (deploy/setup-proxy
    --migrate stops the old one and sets up the new one first). A site keeps its forward: the
    port and the local-ingress forward do not depend on the proxy. The old configuration goes
    once the new one is in place; an old Nginx Proxy Manager is stopped and keeps its hosts in
    its own data. Each site is moved on its own; one that fails does not stop the others."""
    if new not in PROXIES:
        raise SiteError("proxy must be traefik, caddy, nginx, or npm")
    state = load_state()
    if state is None or not (state.get("sites") or state.get("panel")):
        print("No sites to move.")
        return
    sync_installation(state)
    require_edge(new, *capture_edge())
    if new == "traefik":
        notice = ensure_traefik_provider(state)
        if notice:
            print(notice)
    moved, failed, notes = [], [], []
    for host in sorted(state["sites"]):
        site = state["sites"][host]
        old = site.get("proxy")
        if old == new:
            continue
        allow_from = list(site.get("allow_from") or [])
        listen = int(site["listen"])
        try:
            if new == "npm":
                published = npm_publish(state, host, listen, allow_from)
                host_id = published["host_id"]
                if published["note"]:
                    notes.append(f"{host}: {published['note']}")
            else:
                path = site_path(state, new, host)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(render_site(state, new, host, listen, allow_from), encoding="utf-8")
                host_id = None
            note = reload_proxy(state, new, host)
            if note:
                notes.append(f"{host}: {note}")
        except Exception as error:  # one site must not stop the others
            if new != "npm":
                site_path(state, new, host).unlink(missing_ok=True)
            failed.append(f"{host}: {error}")
            continue
        if old in ("traefik", "caddy", "nginx"):
            site_path(state, old, host).unlink(missing_ok=True)
        site["proxy"] = new
        site.pop("npm_host_id", None)
        if host_id is not None:
            site["npm_host_id"] = host_id
        save_state(state)
        moved.append(f"{host} (from {old})")
    panel = state.get("panel")
    if panel and panel["proxy"] != new:
        try:
            status = rift(state, "panel", "status") or {}
            host_id, note = publish_panel_route(state, new, panel["host"], panel_target(state, new, status))
        except Exception as error:  # the sites are moved all the same
            failed.append(f"panel {panel['host']}: {error}")
        else:
            if panel["proxy"] in ("traefik", "caddy", "nginx"):
                site_path(state, panel["proxy"], panel["host"]).unlink(missing_ok=True)
            state["panel"] = {"host": panel["host"], "proxy": new}
            if host_id is not None:
                state["panel"]["npm_host_id"] = host_id
            save_state(state)
            moved.append(f"panel {panel['host']} (from {panel['proxy']})")
            if note:
                notes.append(f"panel {panel['host']}: {note}")
    if moved:
        print(f"Moved to {new} ({len(moved)}):")
        for line in moved:
            print(f"  {line}")
    if failed:
        print(f"Failed ({len(failed)}); run `rift add site AGENT DOMAIN PORT {new}` for each:")
        for line in failed:
            print(f"  {line}")
    if not moved and not failed:
        print(f"Every site already uses {new}.")
    for line in notes:
        print(f"Note: {line}")
    if failed:
        raise SiteError(f"{len(failed)} site(s) could not be moved to {new}")


def command_rm(host):
    state = load_state()
    if state is not None:
        sync_installation(state)
    if state is None or host not in state["sites"]:
        raise SiteError(f"{host} is not a site managed by 'rift add site'")
    site = state["sites"][host]
    note = remove_site_config(state, site, host)
    remove_forward(state, site.get("forward_id"))
    del state["sites"][host]
    save_state(state)
    forward = f"forward {site['forward_id']}" if site.get("forward_id") else "no forward"
    print(f"Site {host} removed: {site['proxy']} configuration and {forward} (agent {site.get('agent', '?')}).")
    if note:
        print(note, file=sys.stderr)
    try:
        reload_proxy(state, site["proxy"], host)
    except SiteError as error:
        print(f"proxy reload: {error}", file=sys.stderr)


def refusal(forwards, forward_id):
    """Why the agent refuses this forward (outside its RIFT_AGENT_ALLOW_PORTS), if it does."""
    for forward in forwards:
        if forward.get("id") == forward_id and forward.get("state") == "refused":
            return forward.get("refused") or "the agent does not allow this port"
    return None


def warn_if_refused(state, forward_id):
    try:
        reason = refusal(rift(state, "list", "forwards") or [], forward_id)
    except SiteError:
        return
    if reason:
        print(f"Warning: the agent refuses this site's forward: {reason}", file=sys.stderr)


def site_forward_alive(site, forwards):
    """The recorded forward still exists and is still this site's (IDs get reused)."""
    forward_id = site.get("forward_id")
    if forward_id is None:
        return False
    for forward in forwards:
        if forward.get("id") != forward_id:
            continue
        try:
            listen, target = int(site["listen"]), int(site["target"])
        except (KeyError, TypeError, ValueError):
            return False
        target_start = int((forward.get("target_ports") or {}).get("start", 0))
        return listen in listen_ports_of(forward) and target_start == target
    return False


def print_table(rows):
    widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]))]
    for row in rows:
        print("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())


def port_range(ports):
    start, end = ports.get("start", 0), ports.get("end", ports.get("start", 0))
    return str(start) if start == end else f"{start}-{end}"


def forward_rows(forwards, agents, sites):
    """The `rift list forwards` table plus a SITE column for forwards that 'rift add site' manages."""
    names = {a.get("id"): a.get("name") for a in agents}
    by_forward = {
        site.get("forward_id"): f"{host} ({site['proxy']})"
        for host, site in sites.items()
        if site.get("forward_id") is not None
    }
    rows = [
        ("ID", "AGENT", "PROTO", "LISTEN", "TARGET", "FAMILY", "INGRESS", "FROM", "MODE", "PURPOSE", "STATE", "SITE")
    ]
    for f in forwards:
        ip = str(f.get("listen_ip", ""))
        ip = f"[{ip}]" if ":" in ip else ip
        rows.append(
            (
                str(f.get("id", "")),
                str(names.get(f.get("agent_id")) or f.get("agent_id", "")),
                str(f.get("protocol", "")).upper(),
                f"{ip}:{port_range(f.get('listen_ports') or {})}",
                port_range(f.get("target_ports") or {}),
                str(f.get("target_family", "")),
                str(f.get("ingress", "")),
                ",".join(f.get("allow_from") or []) or "any",
                str(f.get("mode", "")),
                "exit" if f.get("purpose") == "exit" else "user",
                str(f.get("state") or ("enabled" if f.get("enabled") else "disabled")),
                by_forward.get(f.get("id"), ""),
            )
        )
    return rows


def command_forwards():
    state = load_state()
    if state is not None:
        sync_installation(state)
    else:
        state = default_state("")
    forwards = rift(state, "list", "forwards") or []
    if not forwards:
        print("No forwards configured.")
        return
    agents = rift(state, "list", "agents") or []
    print_table(forward_rows(forwards, agents, state.get("sites") or {}))


def command_list():
    state = load_state()
    if state is not None:
        sync_installation(state)
    sites = (state or {}).get("sites") or {}
    if not sites:
        print("No sites.")
        return
    try:
        forwards = rift(state, "list", "forwards") or []
    except SiteError:
        forwards = None
    rows = [("HOST", "AGENT", "TARGET", "LISTEN", "PROXY", "FROM", "FORWARD")]
    for host, site in sorted(sites.items()):
        if forwards is None:
            status = "unknown"
        else:
            if not site_forward_alive(site, forwards):
                status = "missing"
            elif refusal(forwards, site.get("forward_id")):
                status = "refused"
            else:
                status = "ok"
        forward = f"#{site['forward_id']} {status}" if site.get("forward_id") else status
        rows.append(
            (
                host,
                site["agent"],
                str(site["target"]),
                str(site["listen"]),
                site["proxy"],
                ",".join(site.get("allow_from") or []) or "any",
                forward,
            )
        )
    print_table(rows)
    if any(row[6].endswith("missing") for row in rows[1:]):
        print("A missing forward is created again by 'rift add site AGENT HOST PORT'.")
    if any(row[6].endswith("refused") for row in rows[1:]):
        print("A refused forward needs its target port in the agent's RIFT_AGENT_ALLOW_PORTS.")


CONTAINER_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")


def command_proxy(name, container=None, sites_dir=None):
    """Shows or sets the default proxy. For Caddy, `container` and `sites_dir` say that it runs
    in that Docker container and reads the site files from that host directory."""
    state = load_state() or default_state("")
    if not name:
        print(state.get("proxy") or "traefik")
        return
    if name not in PROXIES:
        raise SiteError("proxy must be traefik, caddy, nginx, or npm")
    if container or sites_dir:
        if name != "caddy":
            raise SiteError("--container and --sites-dir are for caddy")
        if not container or not CONTAINER_NAME.match(container):
            raise SiteError("--container needs the name of the Caddy container")
        if not sites_dir or not sites_dir.startswith("/") or ".." in Path(sites_dir).parts:
            raise SiteError("--sites-dir needs an absolute host directory")
        state["caddy"] = {
            "sites_dir": sites_dir,
            "reload": ["docker", "exec", container, "caddy", "reload", "--config", "/etc/caddy/Caddyfile"],
        }
    state["proxy"] = name
    if not state.get("public_ip"):
        state["public_ip"] = read_server_public_ip(state["container"], state["rift_config"])
    save_state(state)
    print(name)

# ---------------------------------------------------------------------------------------
# Export, import, backup and restore. These run on the host because the files live there;
# the container only produces and consumes streams (`rift export -`, `rift import -`,
# `rift backup -`).

# The export format of `rift export` in the container (src/portable.rs FORMAT); the host adds
# its sites to the same document and checks the number before it imports.
EXPORT_FORMAT = 2
BACKUP_FORMAT = 1
BACKUP_MANIFEST = "rift-backup.json"
BACKUP_SERVER = "server"
BACKUP_HOST = "host/rift-site"
STATE_VOLUME_PATH = "/var/lib/rift"


def today():
    return datetime.date.today().isoformat()


def container_command(state, *args, interactive=False):
    command = ["docker", "exec"]
    if interactive:
        command.append("-i")
    return command + [state["container"], "rift", "--config", state["rift_config"], *args]


def rift_with_input(state, text, *args):
    """Run a container command that reads standard input and prints JSON."""
    completed = subprocess.run(
        container_command(state, "--json", *args, interactive=True),
        input=text,
        text=True,
        capture_output=True,
        check=False,
    )
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "command failed").strip()
        raise SiteError(detail[6:] if detail.startswith("rift: ") else detail)
    return json.loads(completed.stdout)


def site_state():
    """The helper's state, with stale records of an earlier installation dropped."""
    state = load_state()
    if state is None:
        return default_state("")
    sync_installation(state)
    return state


def site_forward_entry(site, entry):
    """Whether an exported forward is the one `rift add site` made for this site."""
    ports = entry.get("listen_ports") or {}
    targets = entry.get("target_ports") or {}
    return (
        entry.get("agent") == site.get("agent")
        and entry.get("ingress") == "local"
        and entry.get("protocol") == "tcp"
        and ports.get("start") == ports.get("end") == int(site.get("listen", 0))
        and targets.get("start") == targets.get("end") == int(site.get("target", 0))
    )


def export_document(core, sites):
    """The core export plus sites; the forwards that belong to sites are left to the sites."""
    document = dict(core)
    records = sorted(sites.items())
    document["forwards"] = [
        entry
        for entry in core.get("forwards", [])
        if not any(site_forward_entry(site, entry) for _, site in records)
    ]
    document["sites"] = [
        {
            "agent": site["agent"],
            "host": host,
            "port": int(site["target"]),
            "proxy": site["proxy"],
            **({"allow_from": list(site["allow_from"])} if site.get("allow_from") else {}),
        }
        for host, site in records
    ]
    return document


def export_summary(document):
    grants = sum(len(d.get("grants", [])) for d in document["devices"])
    return (
        f"{len(document['agents'])} agent(s), {len(document['forwards'])} forward(s), "
        f"{len(document['devices'])} device(s) with {grants} grant(s), "
        f"{len(document['sites'])} site(s)"
    )


def write_file(path, data, mode=0o600):
    """Write through a temporary file so an existing file survives a failed write."""
    path = Path(path)
    partial = path.with_name("." + path.name + ".partial")
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
    except BaseException:
        partial.unlink(missing_ok=True)
        raise
    partial.replace(path)


def command_export(args):
    parser = ArgumentParser("rift export", "Save settings to a JSON file (no keys or tokens).")
    parser.add_argument("file", nargs="?", help="where to write (default: rift-export-DATE.json)")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    options = parser.parse_args(args)
    document, data = export_file()
    path = Path(options.file) if options.file else Path.cwd() / f"rift-export-{today()}.json"
    write_file(path, data, 0o644)
    if options.json:
        print(json.dumps({"file": str(path), **document_counts(document)}))
    else:
        print(path)
        print(f"Exported {export_summary(document)}. The file holds no keys or tokens.")


def export_file():
    """The export document and the exact bytes `rift export` writes."""
    state = site_state()
    document = export_document(rift(state, "export", "-"), state.get("sites") or {})
    return document, (json.dumps(document, indent=2) + "\n").encode("utf-8")


def document_counts(document):
    return {
        "agents": len(document["agents"]),
        "forwards": len(document["forwards"]),
        "devices": len(document["devices"]),
        "grants": sum(len(d.get("grants", [])) for d in document["devices"]),
        "sites": len(document["sites"]),
    }


def check_export_format(document):
    if not isinstance(document, dict) or "format" not in document:
        raise SiteError("this is not a RIFT export file (no \"format\" field)")
    if document["format"] != EXPORT_FORMAT:
        raise SiteError(
            f"this file has export format {document['format']}, but this rift reads format "
            f"{EXPORT_FORMAT}; export again with the same rift version"
        )


def parse_map(value):
    old, separator, new = value.partition("=")
    if not separator or not old or not new or "=" in new:
        raise argparse.ArgumentTypeError("use OLD=NEW, for example node2=node1")
    return old, new


class ArgumentParser(argparse.ArgumentParser):
    def __init__(self, prog, description):
        super().__init__(prog=prog, description=description)

    def error(self, message):
        raise SiteError(f"{message}\n{self.format_usage().strip()}")


def import_target(options, old):
    for source, target in reversed(options["map"]):
        if source == old:
            return target
    return old


def import_filtered(options, name):
    if options["agents"] and name not in options["agents"]:
        return "not selected with --agent"
    if name in options["skip_agents"]:
        return "left out with --skip-agent"
    return None


def agent_problem(name, old, agents):
    """Why an entry for this (mapped) agent cannot be imported, or None."""
    status = agents.get(name)
    if status is None:
        return f"no such agent; create it with `rift add agent {name}` or use --map {old}=NAME"
    if status == "pending":
        return (
            "its invitation is still open; run the import again once "
            f"`rift list agents` shows {name} as active"
        )
    if status == "disabled":
        return f"the agent is disabled; enable it with `rift enable agent {name}`"
    return None


def plan_site_import(entries, options, agents, sites, alive_hosts):
    """What importing the exported sites does: create, present, skipped or failed per site.

    `agents` maps agent names to their status, `sites` are the helper's records and
    `alive_hosts` the sites whose forward still exists.
    """
    plan = []
    for entry in entries:
        host, old = entry["host"], entry["agent"]
        agent = import_target(options, old)
        what = f"site {host} (agent {agent}, port {entry['port']}, {entry['proxy']})"
        problem = import_filtered(options, agent) or agent_problem(agent, old, agents)
        if problem:
            plan.append({"status": "skipped", "what": what, "detail": problem})
        elif entry["proxy"] not in PROXIES or not valid_host(host) or not 1 <= int(entry["port"]) <= 65535:
            plan.append({"status": "failed", "what": what, "detail": "the entry is not a usable site"})
        elif host in sites:
            site = sites[host]
            same = (
                site.get("agent") == agent
                and int(site["target"]) == int(entry["port"])
                and site.get("proxy") == entry["proxy"]
                and list(site.get("allow_from") or []) == list(entry.get("allow_from") or [])
            )
            if same and host in alive_hosts:
                plan.append({"status": "present", "what": what, "detail": None})
            else:
                plan.append(
                    {
                        "status": "failed",
                        "what": what,
                        "detail": (
                            f"{host} exists as a site of agent {site.get('agent')}, port "
                            f"{site.get('target')}, {site.get('proxy')}; remove it first with "
                            f"`rift remove site {host}` to import this one"
                        ),
                    }
                )
        else:
            plan.append(
                {
                    "status": "create",
                    "what": what,
                    "detail": None,
                    "agent": agent,
                    "host": host,
                    "port": int(entry["port"]),
                    "proxy": entry["proxy"],
                    "allow_from": list(entry.get("allow_from") or []),
                }
            )
    return plan


REPORT_GROUPS = (
    ("created", "Created", "Would create"),
    ("present", "Already present", "Already present"),
    ("skipped", "Skipped", "Skipped"),
    ("failed", "Failed", "Failed"),
)


def render_import_report(items, dry_run):
    lines = ["Dry run: nothing was changed."] if dry_run else []
    for status, title, dry_title in REPORT_GROUPS:
        group = [item for item in items if item["status"] == status]
        if not group:
            continue
        if lines:
            lines.append("")
        lines.append(f"{dry_title if dry_run else title} ({len(group)})")
        for item in group:
            detail = item.get("detail")
            if not detail:
                lines.append(f"  {item['what']}")
            elif status == "created":
                lines.append(f"  {item['what']} ({detail})")
            else:
                lines.append(f"  {item['what']}: {detail}")
    if not items:
        lines.append("Nothing to import.")
    return "\n".join(lines)


def import_sites(state, plan, dry_run):
    """Carry out the planned sites; returns the report items."""
    items = []
    for step in plan:
        if step["status"] != "create":
            items.append({k: step[k] for k in ("status", "what", "detail")})
            continue
        if dry_run:
            items.append({"status": "created", "what": step["what"], "detail": None})
            continue
        captured = io.StringIO()
        try:
            with contextlib.redirect_stdout(captured):
                command_add(
                    step["agent"], step["host"], step["port"], step["proxy"], step["allow_from"]
                )
        except SiteError as error:
            items.append({"status": "failed", "what": step["what"], "detail": str(error)})
            continue
        hint = next((l for l in captured.getvalue().splitlines() if l.startswith("DNS:")), None)
        items.append({"status": "created", "what": step["what"], "detail": hint})
    return items


def command_import(args):
    parser = ArgumentParser(
        "rift import",
        "Create what an export file holds and this server lacks. Agents are never created.",
    )
    parser.add_argument("file", help="export file; - reads standard input")
    parser.add_argument("--agent", action="append", default=[], metavar="NAME")
    parser.add_argument("--skip-agent", action="append", default=[], metavar="NAME", dest="skip_agent")
    parser.add_argument("--map", action="append", default=[], metavar="OLD=NEW", type=parse_map)
    parser.add_argument("--dry-run", action="store_true", dest="dry_run")
    parser.add_argument("--json", action="store_true")
    given = parser.parse_args(args)
    options = {
        "agents": given.agent,
        "skip_agents": given.skip_agent,
        "map": given.map,
        "dry_run": given.dry_run,
    }
    raw = sys.stdin.read() if given.file == "-" else Path(given.file).read_text(encoding="utf-8")
    items = run_import(raw, options)
    if given.json:
        print(json.dumps({"dry_run": options["dry_run"], "items": items}))
    else:
        print(render_import_report(items, options["dry_run"]))


def run_import(raw, options):
    """Imports an export file (text) with the options of `rift import`; returns the report items."""
    try:
        document = json.loads(raw)
    except json.JSONDecodeError:
        raise SiteError("this is not a RIFT export file (not JSON)") from None
    check_export_format(document)
    state = site_state()
    argv = ["import", "-"]
    for name in options["agents"]:
        argv += ["--agent", name]
    for name in options["skip_agents"]:
        argv += ["--skip-agent", name]
    for old, new in options["map"]:
        argv += ["--map", f"{old}={new}"]
    if options["dry_run"]:
        argv.append("--dry-run")
    report = rift_with_input(state, raw, *argv)
    items = list(report["items"])
    entries = document["sites"]
    if entries:
        agents = {a["name"]: a["status"] for a in rift(state, "list", "agents") or []}
        forwards = rift(state, "list", "forwards") or []
        sites = state.get("sites") or {}
        alive = {host for host, site in sites.items() if site_forward_alive(site, forwards)}
        plan = plan_site_import(entries, options, agents, sites, alive)
        items += import_sites(state, plan, options["dry_run"])
    return items


def tar_member_name(name):
    """A safe relative archive path, or an error."""
    path = PurePosixPath(name)
    if path.is_absolute() or ".." in path.parts:
        raise SiteError(f"the archive contains an unsafe path: {name}")
    return str(path)


def copy_tar_members(source, destination, prefix):
    """Copy every file and directory under `prefix` from one tar stream into another."""
    for member in source:
        name = tar_member_name(member.name)
        if name == "." or not (name == prefix or name.startswith(prefix + "/")):
            continue
        if not (member.isfile() or member.isdir()):
            raise SiteError(f"the archive contains something other than files: {member.name}")
        destination.addfile(member, source.extractfile(member) if member.isfile() else None)


def command_backup(args):
    parser = ArgumentParser("rift backup", "Save everything, including every key, to a private archive.")
    parser.add_argument("file", nargs="?", help="where to write (default: rift-backup-DATE.tar.gz)")
    parser.add_argument("--json", action="store_true")
    options = parser.parse_args(args)
    path = Path(options.file) if options.file else Path.cwd() / f"rift-backup-{today()}.tar.gz"
    write_backup(path)
    if options.json:
        print(json.dumps({"file": str(path)}))
        return
    print(path)
    print(
        "WARNING: this file contains every key of this server (WireGuard, enrollment CA, "
        "VPN devices) and the panel password.\nKeep it private and store it somewhere safe, "
        "not on this server only."
    )


def write_backup(path):
    """Writes the whole backup archive to `path` (mode 0600), through a partial file."""
    state = site_state()
    path = Path(path)
    partial = path.with_name("." + path.name + ".partial")
    manifest = json.dumps(
        {
            "format": BACKUP_FORMAT,
            "created": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
            "contains": [BACKUP_SERVER, BACKUP_HOST],
        },
        indent=2,
    ).encode("utf-8")
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    producer = subprocess.Popen(
        container_command(state, "backup", "-"), stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    try:
        with os.fdopen(fd, "wb") as out, tarfile.open(fileobj=out, mode="w|gz") as archive:
            info = tarfile.TarInfo(BACKUP_MANIFEST)
            info.size, info.mode, info.mtime = len(manifest), 0o600, int(time.time())
            archive.addfile(info, io.BytesIO(manifest))
            with tarfile.open(fileobj=producer.stdout, mode="r|gz") as server:
                copy_tar_members(server, archive, BACKUP_SERVER)
            for file in sorted(STATE_PATH.parent.glob("*")) if STATE_PATH.parent.is_dir() else []:
                if file.is_file() and not file.name.endswith(".tmp"):
                    archive.add(str(file), arcname=f"{BACKUP_HOST}/{file.name}")
        error = producer.stderr.read().decode("utf-8", "replace").strip()
        if producer.wait() != 0:
            raise SiteError(error[6:] if error.startswith("rift: ") else error or "backup failed")
    except BaseException:
        producer.kill()
        partial.unlink(missing_ok=True)
        raise
    partial.replace(path)


def verify_backup(path):
    """Read the whole archive once. Returns (manifest, server file count, host files)."""
    try:
        archive = tarfile.open(path, "r:gz")
    except (tarfile.TarError, OSError) as error:
        raise SiteError(f"{path} is not a RIFT backup: {error}") from None
    host = {}
    server_files = set()
    manifest = None
    try:
        with archive:
            for member in archive:
                name = tar_member_name(member.name)
                if not (member.isfile() or member.isdir()):
                    raise SiteError(f"the backup contains something other than files: {member.name}")
                if member.isfile():
                    data = archive.extractfile(member).read()
                if name == BACKUP_MANIFEST and member.isfile():
                    manifest = json.loads(data)
                elif member.isfile() and name.startswith(BACKUP_SERVER + "/"):
                    server_files.add(name[len(BACKUP_SERVER) + 1 :])
                elif member.isfile() and name.startswith(BACKUP_HOST + "/"):
                    leaf = name[len(BACKUP_HOST) + 1 :]
                    if "/" in leaf:
                        raise SiteError(f"the backup contains an unexpected path: {name}")
                    host[leaf] = data
                elif name not in (BACKUP_SERVER, "host", BACKUP_HOST) and not name.startswith(
                    (BACKUP_SERVER + "/", BACKUP_HOST + "/")
                ):
                    raise SiteError(f"the backup contains an unexpected path: {name}")
    except (tarfile.TarError, EOFError, OSError, json.JSONDecodeError) as error:
        raise SiteError(f"{path} is damaged: {error}") from None
    if not isinstance(manifest, dict) or "format" not in manifest:
        raise SiteError(f"{path} is not a RIFT backup (no {BACKUP_MANIFEST})")
    if manifest["format"] != BACKUP_FORMAT:
        raise SiteError(
            f"this backup has format {manifest['format']}, but this rift reads format {BACKUP_FORMAT}"
        )
    for required in ("state.db", "wireguard.key"):
        if required not in server_files:
            raise SiteError(f"{path} is incomplete: server/{required} is missing")
    return manifest, len(server_files), host


def state_volume(inspected):
    """The volume or directory behind /var/lib/rift in `docker inspect` output."""
    document = inspected[0] if isinstance(inspected, list) else inspected
    for mount in document.get("Mounts") or []:
        if mount.get("Destination") == STATE_VOLUME_PATH:
            if mount.get("Type") == "volume" and mount.get("Name"):
                return mount["Name"]
            if mount.get("Source"):
                return mount["Source"]
    raise SiteError(f"{STATE_VOLUME_PATH} is not a volume of the server container")


def wait_for_server(state, seconds=90):
    deadline = time.time() + seconds
    while time.time() < deadline:
        probe = subprocess.run(
            container_command(state, "--json", "list", "agents"),
            capture_output=True,
            check=False,
        )
        if probe.returncode == 0:
            return True
        time.sleep(2)
    return False


def resync_sites():
    """Write the proxy configuration of every recorded site again.

    The records come from a backup; the proxy files and Nginx Proxy Manager hosts do not,
    and the public address of a new server differs.
    """
    state = load_state()
    sites = (state or {}).get("sites") or {}
    if not sites:
        print("No sites to re-create.")
        return 0
    state["public_ip"] = read_server_public_ip(state["container"], state["rift_config"])
    save_state(state)
    failed = 0
    for host, site in sorted(sites.items()):
        try:
            captured = io.StringIO()
            with contextlib.redirect_stdout(captured):
                command_add(
                    site["agent"], host, int(site["target"]), site["proxy"], site.get("allow_from") or []
                )
            print(f"Site {host}: proxy configuration written.")
        except SiteError as error:
            failed += 1
            print(f"Site {host}: not re-created: {error}", file=sys.stderr)
            print(f"  Fix the cause, then run: rift add site {site['agent']} {host} {site['target']} {site['proxy']}", file=sys.stderr)
    return failed


def command_restore(args):
    parser = ArgumentParser("rift restore", "Replace all state on this server with a backup.")
    parser.add_argument("file")
    parser.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    parser.add_argument(
        "--no-safety-backup",
        action="store_true",
        help="do not save the current state first (only when that is impossible)",
    )
    parser.add_argument("--json", action="store_true")
    options = parser.parse_args(args)
    if os.geteuid() != 0:
        raise SiteError("restore replaces the server's state volume; run it with sudo")
    path = Path(options.file)
    if not path.is_file():
        raise SiteError(f"{path} does not exist")
    manifest, count, host = verify_backup(path)
    state = load_state() or default_state("")
    container = state["container"]
    inspected = run(["docker", "inspect", container])
    volume = state_volume(json.loads(inspected))
    image = run(["docker", "inspect", "--format", "{{.Image}}", container]).strip()
    if not options.yes:
        if not sys.stdin.isatty():
            raise SiteError("restore needs your confirmation: add --yes to run it without asking")
        answer = input(
            f"This replaces ALL RIFT state on this server (agents, forwards, keys, devices) with "
            f"the backup made {manifest.get('created', 'at an unknown time')}.\n"
            f"Everything that is here now is lost. Type yes to continue: "
        )
        if answer.strip().lower() != "yes":
            raise SiteError("cancelled; nothing was changed")
    if not options.no_safety_backup:
        # The volume is emptied below; keep what is there now in case the backup is not the
        # one you meant.
        stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M%S")
        safety = Path.cwd() / f"rift-before-restore-{stamp}.tar.gz"
        try:
            command_backup([str(safety)])
        except (SiteError, OSError, tarfile.TarError) as error:
            raise SiteError(
                f"could not save the current state first ({error}); nothing was changed. "
                "Start the server, or add --no-safety-backup to restore without it."
            ) from None
        print(f"The previous state is saved in {safety}; restore it the same way if needed.")
    print(f"Stopping {container}...")
    run(["docker", "stop", "-t", "60", container])
    print(f"Writing {count} file(s) to {volume}...")
    loader = subprocess.Popen(
        [
            "docker", "run", "--rm", "-i", "--network", "none",
            "-v", f"{volume}:/data",
            "--entrypoint", "sh", image,
            "-c", "find /data -mindepth 1 -delete && chmod 700 /data && tar -xpf - -C /data",
        ],
        stdin=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    try:
        with tarfile.open(path, "r:gz") as source, tarfile.open(fileobj=loader.stdin, mode="w|") as out:
            for member in source:
                name = tar_member_name(member.name)
                if name == BACKUP_SERVER or not name.startswith(BACKUP_SERVER + "/"):
                    continue
                member.name = name[len(BACKUP_SERVER) + 1 :]
                member.uid = member.gid = 0
                member.uname = member.gname = "root"
                out.addfile(member, source.extractfile(member) if member.isfile() else None)
        loader.stdin.close()
        failure = loader.stderr.read().decode("utf-8", "replace").strip()
        if loader.wait() != 0:
            raise SiteError(failure or "writing the state volume failed")
    except BaseException as error:
        loader.kill()
        raise SiteError(
            f"the state volume may be incomplete and {container} stays stopped: {error}. "
            "Run the restore again with the same file."
        ) from None
    if host:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        for leaf, data in host.items():
            write_file(STATE_PATH.parent / leaf, data)
    print(f"Starting {container}...")
    run(["docker", "start", container])
    ready = wait_for_server(state)
    failed = 0
    if ready:
        failed = resync_sites()
    if options.json:
        print(json.dumps({"restored": True, "server_ready": ready, "sites_failed": failed}))
        return
    print("Restored.")
    if not ready:
        print(f"{container} did not answer within 90 seconds; check: docker logs {container}")
    print(restore_next_steps())


def restore_next_steps():
    return (
        "Next steps:\n"
        "  1. rift status           the server and its forwards should be listed.\n"
        "  2. RIFT_PUBLIC_IPS       forwards on an address this server does not have moved to its\n"
        "                           first address of the same IP version; rift status says which.\n"
        "  3. DNS                   point RIFT_PUBLIC_ENDPOINT (and the names of your sites) at this\n"
        "                           server. Agents that connect by a raw IP: set RIFT_SERVER in their\n"
        "                           .env to this server and restart them.\n"
        "  4. Firewall              open UDP 51820 (WireGuard) and each public port in the cloud\n"
        "                           firewall of this server."
    )


QUEUE_DIR = Path(os.environ.get("RIFT_SITE_QUEUE", "/var/lib/rift-site-queue"))
QUEUE_REQUEST = re.compile(r"^([0-9a-f]{32})\.json$")
QUEUE_RESULT_AGE = 24 * 3600
QUEUE_MAX_BYTES = 4096
# An import carries a whole export file.
QUEUE_MAX_IMPORT = 512 * 1024
QUEUE_MAX_MESSAGE = 4000
# A file the panel fetches (export, import report, backup) is removed after it, or after
# this many seconds: a backup holds every key.
QUEUE_DATA_AGE = 15 * 60
QUEUE_KEYS = {
    "add": ({"id", "action", "agent", "host", "port"}, {"proxy", "allow_from"}),
    "remove": ({"id", "action", "host"}, set()),
    "export": ({"id", "action"}, set()),
    "backup": ({"id", "action"}, set()),
    "import": ({"id", "action", "document", "dry_run"}, {"map"}),
}


def parse_queue_request(name, raw):
    """A request from the web panel's container, checked as if it came from anyone.

    Only the actions in QUEUE_KEYS exist, each with exactly its own keys. Raises SiteError
    otherwise.
    """
    try:
        request = json.loads(raw)
    except (ValueError, UnicodeDecodeError):
        raise SiteError("the request is not valid JSON") from None
    if not isinstance(request, dict):
        raise SiteError("the request must be a JSON object")
    action = request.get("action")
    if not isinstance(action, str) or action not in QUEUE_KEYS:
        raise SiteError(f"only the actions {', '.join(QUEUE_KEYS)} are accepted")
    required, optional = QUEUE_KEYS[action]
    keys = set(request)
    if not required <= keys or keys - required - optional:
        raise SiteError(f"a {action} request has exactly the keys {', '.join(sorted(required | optional))}")
    if request["id"] != name:
        raise SiteError("the request id does not match its file name")
    if action != "import" and len(raw) > QUEUE_MAX_BYTES:
        raise SiteError("the request is too large")
    if action in ("export", "backup"):
        return action, ()
    if action == "import":
        document, dry_run = request["document"], request["dry_run"]
        if not isinstance(document, dict):
            raise SiteError("document must be an export file (a JSON object)")
        if not isinstance(dry_run, bool):
            raise SiteError("dry_run must be true or false")
        pairs = request.get("map", [])
        if not isinstance(pairs, list) or not all(isinstance(p, str) for p in pairs):
            raise SiteError("map must be a list of OLD=NEW")
        mapped = []
        for pair in pairs:
            try:
                old, new = parse_map(pair)
            except argparse.ArgumentTypeError as error:
                raise SiteError(str(error)) from None
            if not valid_agent(old) or not valid_agent(new):
                raise SiteError(f"{pair}: both sides must be agent names")
            mapped.append((old, new))
        options = {"agents": [], "skip_agents": [], "map": mapped, "dry_run": dry_run}
        return action, (json.dumps(document), options)
    host = request["host"]
    if not isinstance(host, str) or not valid_host(host):
        raise SiteError("host is not a valid domain name")
    if action == "remove":
        return action, (host,)
    agent, port, proxy = request["agent"], request["port"], request.get("proxy")
    if not isinstance(agent, str) or not valid_agent(agent):
        raise SiteError("agent is not a usable name")
    if type(port) is not int or not 1 <= port <= 65535:
        raise SiteError("port must be a number in 1..65535")
    if proxy is not None and (not isinstance(proxy, str) or proxy not in PROXIES):
        raise SiteError("proxy must be traefik, caddy, nginx or npm")
    allow_from = request.get("allow_from", [])
    if not isinstance(allow_from, list):
        raise SiteError("allow_from must be a list of addresses or networks")
    return action, (agent, host, port, proxy, parse_allow_from(allow_from))


def read_queue_file(path):
    """The bytes of a regular file in the queue. Links and other file types are refused."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    try:
        descriptor = os.open(path, flags)
    except OSError:
        raise SiteError("the request is not a regular file") from None
    with os.fdopen(descriptor, "rb") as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise SiteError("the request is not a regular file")
        data = handle.read(QUEUE_MAX_IMPORT + 1)
    if len(data) > QUEUE_MAX_IMPORT:
        raise SiteError("the request is too large")
    return data


def join_message(output, error):
    return "\n".join(part for part in (output.strip(), error.strip()) if part)


def run_queue_request(action, args, queue=None, name=None):
    """Runs the validated request through the same code as the command line.

    Returns (ok, message, file): `file` is the name of the file the panel fetches next to the
    result (an export, an import report or a backup), or None.
    """
    output = io.StringIO()
    file = None
    try:
        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
            if action == "add":
                command_add(*args)
            elif action == "remove":
                command_rm(*args)
            elif action == "export":
                document, data = export_file()
                file = f"rift-export-{today()}.json"
                write_queue_data(queue, name, data)
                print(f"Exported {export_summary(document)}. The file holds no keys or tokens.")
            elif action == "backup":
                file = f"rift-backup-{today()}.tar.gz"
                write_backup(queue / f"{name}.data")
                print("The backup holds every key of this server. Keep it private.")
            else:
                raw, options = args
                items = run_import(raw, options)
                file = "report.json"
                report = {"dry_run": options["dry_run"], "items": items}
                write_queue_data(queue, name, (json.dumps(report) + "\n").encode("utf-8"))
                print(render_import_report(items, options["dry_run"]))
    except SiteError as error:
        discard_queue_data(queue, name)
        return False, join_message(output.getvalue(), str(error)), None
    except Exception as error:  # a failing request must not stop the others
        discard_queue_data(queue, name)
        return False, join_message(output.getvalue(), f"{type(error).__name__}: {error}"), None
    return True, output.getvalue().strip(), file


def write_queue_data(queue, name, data):
    """The file the panel fetches for request `name`, mode 0600, written in one rename."""
    temporary = queue / f"{name}.data.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(data)
    os.replace(temporary, queue / f"{name}.data")


def discard_queue_data(queue, name):
    if queue is not None and name is not None:
        for suffix in (".data", ".data.tmp", ".data.partial"):
            (queue / f"{name}{suffix}").unlink(missing_ok=True)
        (queue / f".{name}.data.partial").unlink(missing_ok=True)


def write_queue_result(queue, name, ok, message, file=None):
    message = message.strip()
    if len(message) > QUEUE_MAX_MESSAGE:
        message = message[:QUEUE_MAX_MESSAGE] + "..."
    answer = {"id": name, "ok": ok, "message": message}
    if file:
        answer["file"] = file
    document = json.dumps(answer) + "\n"
    temporary = queue / f"{name}.result.json.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        handle.write(document)
    os.replace(temporary, queue / f"{name}.result.json")


def clean_queue_results(queue, now):
    for entry in os.scandir(queue):
        if entry.name.endswith(".data") or entry.name.endswith(".partial"):
            age = QUEUE_DATA_AGE
        elif entry.name.endswith(".result.json") or entry.name.endswith(".tmp"):
            age = QUEUE_RESULT_AGE
        else:
            continue
        try:
            if now - entry.stat(follow_symlinks=False).st_mtime > age:
                os.unlink(entry.path)
        except OSError:
            pass


def command_process_queue(queue=None, now=None):
    """Handles the requests the web panel queued, oldest first, and answers each one.

    Nothing from a request is used beyond its validated parameters. Every request file is
    removed, whatever happened, so the path unit does not start again for it.
    """
    queue = Path(queue or QUEUE_DIR)
    if not queue.is_dir():
        return 0
    processed = 0
    while True:
        found = []
        for entry in os.scandir(queue):
            match = QUEUE_REQUEST.fullmatch(entry.name)
            if match:
                try:
                    found.append((entry.stat(follow_symlinks=False).st_mtime, entry.name, match.group(1)))
                except OSError:
                    pass
        if not found:
            break
        for _, filename, name in sorted(found):
            path = queue / filename
            try:
                action, args = parse_queue_request(name, read_queue_file(path))
                ok, message, file = run_queue_request(action, args, queue, name)
            except SiteError as error:
                ok, message, file = False, f"request refused: {error}", None
            try:
                write_queue_result(queue, name, ok, message, file)
            finally:
                os.unlink(path)
            processed += 1
    clean_queue_results(queue, time.time() if now is None else now)
    return processed


def usage():
    return (
        "usage: rift add site AGENT HOST PORT [traefik|caddy|nginx|npm] [--allow-from ADDRESS[,NETWORK...]]\n"
        "       rift remove site HOST\n"
        "       rift list sites\n"
        "       rift proxy [traefik|caddy|nginx|npm] [--container NAME --sites-dir DIR]\n"
        "       rift export [FILE]\n"
        "       rift import FILE [--agent NAME]... [--skip-agent NAME]... [--map OLD=NEW]... [--dry-run]\n"
        "       rift backup [FILE]\n"
        "       rift restore FILE [--yes] [--no-safety-backup]"
    )


def parse_add_args(args):
    """Split `add` arguments into (AGENT, HOST, PORT), the optional proxy (the fourth word) and
    the --allow-from networks (repeatable, also as --allow-from=LIST)."""
    words, allow = [], []
    rest = list(args)
    while rest:
        arg = rest.pop(0)
        if arg == "--allow-from":
            if not rest:
                raise SiteError("--allow-from needs addresses or networks, for example 203.0.113.7")
            allow.append(rest.pop(0))
        elif arg.startswith("--allow-from="):
            allow.append(arg.split("=", 1)[1])
        elif arg.startswith("-"):
            raise SiteError(usage())
        else:
            words.append(arg)
    if len(words) not in (3, 4):
        raise SiteError(usage())
    proxy = words[3] if len(words) == 4 else None
    if proxy is not None and proxy not in PROXIES:
        raise SiteError(f"unknown proxy {proxy}; use traefik, caddy, nginx or npm")
    nets = parse_allow_from(allow)
    if allow and not nets:
        raise SiteError("--allow-from needs addresses or networks, for example 203.0.113.7")
    return list(words[:3]), proxy, nets


def main(argv):
    """Commands as the host `rift` wrapper passes them: add, remove, list, forwards, proxy, purge,
    export, import, backup, restore, process-queue and resync."""
    if len(argv) < 2:
        raise SiteError(usage())
    command = argv[1]
    if command == "add":
        args, proxy, allow_from = parse_add_args(argv[2:])
        command_add(args[0], args[1], args[2], proxy, allow_from)
        return
    if command == "remove" and len(argv) == 3:
        command_rm(argv[2])
        return
    if command == "list" and len(argv) == 2:
        command_list()
        return
    if command == "forwards" and len(argv) == 2:
        command_forwards()
        return
    if command == "proxy" and len(argv) in (2, 3, 5, 7):
        rest = argv[3:]
        options = dict(zip(rest[::2], rest[1::2]))
        if set(options) - {"--container", "--sites-dir"} or len(options) * 2 != len(rest):
            raise SiteError(usage())
        command_proxy(
            argv[2] if len(argv) > 2 else None, options.get("--container"), options.get("--sites-dir")
        )
        return
    if command == "purge" and len(argv) == 2:
        command_purge()
        return
    if command == "panel-route" and len(argv) == 3:
        command_panel_route(argv[2:])
        return
    if command == "migrate-sites" and len(argv) == 3:
        command_migrate_sites(argv[2])
        return
    if command == "export":
        command_export(argv[2:])
        return
    if command == "import":
        command_import(argv[2:])
        return
    if command == "backup":
        command_backup(argv[2:])
        return
    if command == "restore":
        command_restore(argv[2:])
        return
    if command == "process-queue" and len(argv) == 2:
        command_process_queue()
        return
    if command == "resync" and len(argv) == 2:
        sys.exit(1 if resync_sites() else 0)
    raise SiteError(usage())


if __name__ == "__main__":
    try:
        main(sys.argv)
    except (SiteError, json.JSONDecodeError, KeyError, ValueError) as error:
        print(f"rift: {error}", file=sys.stderr)
        sys.exit(1)
