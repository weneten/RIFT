#!/bin/sh
# Install the host-side server CLI and website helper.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
install -d -m 755 /usr/local/bin /usr/local/lib/rift
install -m 755 "$script_dir/rift-site" /usr/local/lib/rift/rift-site
install -m 755 "$script_dir/rift" /usr/local/bin/rift
printf '%s\n' 'Installed /usr/local/bin/rift and /usr/local/lib/rift/rift-site.'
