#!/bin/sh
# Host-side entry point for server administration.
set -eu

site=/usr/local/lib/rift/rift-site

# Sites live on the host: the helper writes the proxy configuration.
case "${1-} ${2-}" in
    "add site" | "remove site")
        cmd=$1
        shift 2
        exec "$site" "$cmd" "$@"
        ;;
    "list sites")
        exec "$site" list
        ;;
esac
# Commands that read or write files in the current directory run on the host; the container
# only produces and consumes streams. `--help` is answered by the container's own help text.
json=
if [ "${1-}" = --json ]; then
    case "${2-}" in
        export | import | backup | restore)
            json=--json
            shift
            ;;
    esac
fi
case "${1-}" in
    export | import | backup | restore)
        case " $* " in
            *" --help "* | *" -h "*) ;;
            *)
                cmd=$1
                shift
                exec "$site" "$cmd" $json "$@"
                ;;
        esac
        ;;
esac
if [ "${1-}" = proxy ]; then
    shift
    exec "$site" proxy "$@"
fi

if [ "${1-}" = list ] && [ "${2-}" = forwards ] && [ "$#" -eq 2 ] && [ -x "$site" ]; then
    # The same table with a SITE column for forwards that `rift add site` manages. Any problem
    # falls through to the plain command below.
    "$site" forwards 2> /dev/null && exit 0
fi

case "$(docker inspect -f '{{.State.Status}}' rift-server 2> /dev/null || true)" in
    running) ;;
    restarting)
        echo "rift: the rift-server container keeps restarting. Its last message:" >&2
        docker logs --tail 1 rift-server 2>&1 | sed 's/^/  /' >&2
        exit 1
        ;;
    "")
        echo "rift: there is no rift-server container; start it with 'docker compose up -d' in the RIFT directory" >&2
        exit 1
        ;;
    *)
        echo "rift: the rift-server container is not running; start it with 'docker compose up -d' in the RIFT directory" >&2
        exit 1
        ;;
esac
exec docker exec rift-server rift --config /etc/rift/config.toml $json "$@"
