# RIFT server (VPS). `sudo sh deploy/setup-server` writes this file and asks for every setting
# below in the same order. By hand: cp .env.server.example .env, then edit it.
# A commented-out line shows RIFT's default; remove the # to change it. After a change:
#   docker compose up -d --force-recreate

# ---------- Image ----------
# COMPOSE_PROFILES selects the server service. The container command is server.
COMPOSE_PROFILES=server
# Pin the image to a release, e.g. 1.0.0, and check out the matching tag (git checkout v1.0.0).
# latest follows the main branch. Update the server first; it also serves agents of the previous release.
# RIFT_VERSION=latest

# ---------- Addresses ----------
# Addresses configured on the VPS network interface, comma-separated (IPv4 and/or IPv6). A DNS name is
# not accepted. Forwards listen on the first IPv4 address; a port spec ending in /v6 or /all also uses
# the first IPv6 address. Add the IPv6 address only if you want to publish forwards over IPv6 too.
RIFT_PUBLIC_IPS=203.0.113.10
# Behind a cloud NAT (e.g. Oracle Cloud) the public address is not on the interface; `ip -4 addr` shows only
# a private one. Then put that private address in RIFT_PUBLIC_IPS, keep the public DNS name in
# RIFT_PUBLIC_ENDPOINT, and set this to true. Loopback and link-local addresses stay forbidden.
# RIFT_ALLOW_PRIVATE_LISTENERS=false
# DNS name or address agents dial, without a port. This name is also the enrollment certificate SAN.
RIFT_PUBLIC_ENDPOINT=rift.example.net

# ---------- Ports and enrollment ----------
# WireGuard UDP port. Change it if 51820 is already used on the host (open the new port in your firewall).
# 51821-51899 are taken by internet exits.
# RIFT_WG_PORT=51820
# Enrollment listener, ADDRESS:PORT (TCP). Not 8444, the tunnel control port.
# RIFT_ENROLLMENT_BIND=0.0.0.0:8443
# auto: the enrollment port listens only while an invitation from `rift add agent` is open and
# closes again once the agent is active or the invitation expires or is cancelled.
# always: keep it open permanently. off: no enrollment.
# RIFT_ENROLLMENT=auto

# ---------- Tunnel addresses ----------
# Change these if they overlap a host interface or route. The server address must lie inside
# its pool. Pool changes need a restart.
# RIFT_IPV4_POOL=10.13.0.0/24
# RIFT_SERVER_IPV4=10.13.0.1
# RIFT_IPV6_POOL=fd88:5249:4654::/64
# RIFT_SERVER_IPV6=fd88:5249:4654::1

# ---------- VPN devices (rift vpn ...) ----------
# IPv4 addresses of VPN devices. Must not overlap the IPv4 tunnel pool or a LAN you grant.
# The first host of each pool is reserved for the exit interface of agents.
# RIFT_VPN_POOL=10.14.0.0/24
# IPv6 addresses of VPN devices: a ULA network that does not overlap RIFT_IPV6_POOL.
# RIFT_VPN_POOL6=fd88:5249:4655::/64
# DNS servers for devices with an internet exit (`rift vpn allow DEVICE exit`), comma-separated.
# At least one IPv4 address; IPv6 ones are used only where the exit carries IPv6.
# RIFT_VPN_DNS=9.9.9.9,2620:fe::fe

# ---------- Web panel ----------
# The dashboard on the VPS. Changes to these settings need a restart.
# RIFT_WEBPANEL=false
# Login password, at least 12 characters, without spaces, quotes, \, $, # or backticks.
# Empty: RIFT generates one; show it with `rift panel password`.
# RIFT_WEBPANEL_PASSWORD=
# Second login factor (authenticator app). optional: off until turned on in the panel or with
# `rift panel 2fa setup`. required: no login until it is set up with the CLI. Reset: `rift panel 2fa reset`.
# RIFT_WEBPANEL_2FA=optional
# private: only on the VPS itself (http://127.0.0.1:8090, also through an SSH tunnel) and for
#   VPN devices granted with `rift panel connect NAME` (http://10.13.0.1:8090).
# public: on every address. Plain HTTP: put a TLS proxy in front or restrict RIFT_WEBPANEL_ALLOW.
# RIFT_WEBPANEL_ACCESS=private
# Who may change things in the panel. private: sessions from the VPS itself or an SSH tunnel
# (loopback without proxy headers) and from VPN devices with panel access; everyone else only reads.
# public: also through a TLS proxy (RIFT_WEBPANEL_PROXIES or on this VPS) over HTTPS, so the panel password
#   (and the code, if two-factor login is on) is all that protects changes from the internet. Turn
#   two-factor login on. Set by deploy/publish-panel.
# off: the panel is read-only for everyone.
# RIFT_WEBPANEL_CONTROL=private
# TCP port of the panel; must differ from 8444 and the enrollment port.
# RIFT_WEBPANEL_PORT=8090
# Rarely needed. VPN devices from `rift panel connect` are always allowed and need no entry here.
# Addresses or networks listed here (comma-separated, e.g. 198.51.100.7) may open the panel read-only:
# - public mode: restrict the panel to these addresses (e.g. your fixed home IP) plus the VPS itself
#   and the panel devices; without a list everyone can reach the login page.
# - private mode: let an agent host (10.13.0.x) look at the panel through the tunnel.
# RIFT_WEBPANEL_ALLOW=
# Public mode takes the password over HTTPS only: through a TLS proxy that sends X-Forwarded-Proto: https.
# List the proxy's address here (e.g. 192.0.2.80) unless it runs on this VPS (loopback needs no entry).
# RIFT_WEBPANEL_PROXIES=
# true allows the password over plain HTTP in public mode (test setups only).
# RIFT_WEBPANEL_INSECURE=false

# ---------- Terminal UI ----------
# `rift` without a command opens a full-screen terminal UI on the server (keyboard and mouse):
# agents, forwards, VPN devices, sites, bans, the panel, the log and the health checks. Every
# `rift ...` command keeps working either way. false: `rift` alone prints the help instead.
# RIFT_TUI=true

# ---------- Websites (rift add site) ----------
# Only for Nginx Proxy Manager: login of an NPM admin. deploy/setup-proxy npm sets both.
# RIFT_NPM_EMAIL=
# RIFT_NPM_PASSWORD=
# Contact for expiry notices (e.g. admin@example.net). Without it certbot registers without an
# email and Nginx Proxy Manager uses the admin login address.
# RIFT_LETSENCRYPT_EMAIL=
# Nginx (certbot) and Nginx Proxy Manager: request a Let's Encrypt certificate for each new site.
# This accepts the Let's Encrypt terms of service. false: handle certificates yourself.
# Traefik and Caddy ignore it.
# RIFT_REQUEST_CERTIFICATE=true
# The Docker network of the proxies that deploy/setup-proxy sets up (and deploy/publish-panel trusts).
# RIFT_PROXY_SUBNET=10.255.13.0/24
