# Copy to .env on the VPS: cp .env.server.example .env
# COMPOSE_PROFILES selects the server service. The container command is server.
COMPOSE_PROFILES=server

# DNS name or address agents dial, without a port. This name is also the enrollment certificate SAN.
RIFT_PUBLIC_ENDPOINT=rift.example.net
# Address configured on the VPS network interface. A DNS name is not accepted.
RIFT_PUBLIC_IPS=203.0.113.10

# Optional.
# RIFT_ENROLLMENT_BIND=0.0.0.0:8443
# RIFT_ENROLLMENT_ENABLED=true

# Tunnel pools. Change these if they overlap a host interface (e.g. podman0 uses 10.88.0.0/16).
# The server address must lie inside its pool. Pool changes need a restart.
# RIFT_IPV4_POOL=10.88.0.0/24
# RIFT_SERVER_IPV4=10.88.0.1
# RIFT_IPV6_POOL=fd88:5249:4654::/64
# RIFT_SERVER_IPV6=fd88:5249:4654::1
