# Copy to .env on the VPS: cp .env.server.example .env
# COMPOSE_PROFILES selects the server service. The container command is server.
COMPOSE_PROFILES=server

# DNS name or address agents dial, without a port. This name is also the enrollment certificate SAN.
RIFT_PUBLIC_ENDPOINT=rift.example.net
# Address configured on the VPS network interface. A DNS name is not accepted.
RIFT_PUBLIC_IPS=203.0.113.10
# Behind a cloud NAT (e.g. Oracle Cloud) the public address is not on the interface; `ip -4 addr` shows only
# a private one. Then put that private address in RIFT_PUBLIC_IPS, keep the public DNS name in
# RIFT_PUBLIC_ENDPOINT, and set this to true. Loopback and link-local addresses stay forbidden.
# RIFT_ALLOW_PRIVATE_LISTENERS=false

# Optional.
# RIFT_ENROLLMENT_BIND=0.0.0.0:8443
# Enrollment port: auto (default) listens only while an invitation from `rift agents add` is open and
# closes again once the agent is active or the invitation expires or is cancelled.
# true (always) keeps it open permanently; false turns enrollment off.
# RIFT_ENROLLMENT_ENABLED=auto

# Only for `rift site` (website helper), with Nginx (certbot) or Nginx Proxy Manager.
# Request a Let's Encrypt certificate for each new site (default true). This accepts the Let's Encrypt
# terms of service. Set false to skip it and handle certificates yourself. Traefik and Caddy ignore it.
# RIFT_REQUEST_CERTIFICATE=true
# Optional contact for expiry notices. Without it certbot registers without an email and
# Nginx Proxy Manager uses the admin login address.
# RIFT_LETSENCRYPT_EMAIL=admin@example.net
# Only for `--proxy npm`: login of a Nginx Proxy Manager admin.
# RIFT_NPM_EMAIL=admin@example.net
# RIFT_NPM_PASSWORD=
# After changing these, recreate the container: docker compose up -d --force-recreate

# WireGuard UDP port. Change it if 51820 is already used on the host (open the new port in your firewall).
# RIFT_WG_PORT=51820

# Tunnel pools. Change these if they overlap a host interface or route.
# The server address must lie inside its pool. Pool changes need a restart.
# RIFT_IPV4_POOL=10.13.0.0/24
# RIFT_SERVER_IPV4=10.13.0.1
# RIFT_IPV6_POOL=fd88:5249:4654::/64
# RIFT_SERVER_IPV6=fd88:5249:4654::1

# Addresses for private VPN devices (rift vpn ...). Must not overlap the IPv4 tunnel pool or a LAN you grant.
# RIFT_VPN_POOL=10.14.0.0/24

# Web panel (dashboard) on the VPS. Off unless RIFT_WEBPANEL=true; changes need a restart.
# RIFT_WEBPANEL=false
# private (default): only on the VPS itself (http://127.0.0.1:8090, also through an SSH tunnel) and for
#   VPN devices granted with `rift panel connect NAME` (http://10.13.0.1:8090).
# public: on every address. Plain HTTP: put a TLS proxy in front or restrict RIFT_WEBPANEL_ALLOW.
# RIFT_WEBPANEL_ACCESS=private
# RIFT_WEBPANEL_PORT=8090
# Who may change things in the panel. private (default): sessions from the VPS itself or an SSH tunnel
# (loopback without proxy headers) and from VPN devices with panel access; everyone else only reads.
# off: the panel is read-only for everyone.
# RIFT_WEBPANEL_CONTROL=private
# Extra source addresses or networks that may open the panel, comma-separated. In public mode a
# non-empty list restricts the panel to these, loopback and the granted VPN devices.
# RIFT_WEBPANEL_ALLOW=10.14.0.5,198.51.100.0/24
# Login password, at least 12 characters. Without it RIFT generates one; show it with `rift panel password`.
# RIFT_WEBPANEL_PASSWORD=
