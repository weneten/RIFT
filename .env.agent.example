# RIFT agent (home server). `sudo sh deploy/join` writes this file and asks for every setting
# below in the same order. By hand: cp .env.agent.example .env, then edit it.
# A commented-out line shows RIFT's default; remove the # to change it. After a change:
#   docker compose up -d --force-recreate

# ---------- Image ----------
# COMPOSE_PROFILES selects the agent service. The container command is agent.
COMPOSE_PROFILES=agent
# Pin the image to a release, e.g. 1.0.0, and check out the matching tag (git checkout v1.0.0).
# latest follows the main branch. Update the server first; it also serves agents of the previous release.
# RIFT_VERSION=latest

# ---------- Invitation (from `rift add agent NAME` on the server) ----------
# Hostname and port from the invitation. The port is required.
RIFT_SERVER=rift.example.net:8443
RIFT_AGENT_NAME=node1
# The one-time invitation value. deploy/join removes it once the agent is active; an active agent ignores it.
RIFT_ENROLLMENT_TOKEN=

# ---------- What the server may open on this host ----------
# These limits hold even against a compromised server.
# Ports this agent may open for forwards and VPN grants, e.g. 22/tcp,80,27015-27020/udp. Empty: no limit.
# RIFT_AGENT_ALLOW_PORTS=
# Networks behind this agent that VPN network grants may reach, e.g. 192.168.178.0/24 (single hosts
# as /32). Empty: no LAN access.
# RIFT_AGENT_ALLOW_SUBNETS=
# true offers this host's internet connection as an exit for VPN devices (rift vpn allow DEVICE AGENT exit).
# Devices are masqueraded and cannot reach private networks except those in RIFT_AGENT_ALLOW_SUBNETS. This also
# allows the one UDP port of the exit, whatever RIFT_AGENT_ALLOW_PORTS says.
# RIFT_AGENT_ALLOW_EXIT=false

# ---------- Terminal UI ----------
# `rift` without a command opens a full-screen terminal UI on this host (keyboard and mouse):
# the tunnel, its traffic, the forwards, the log and the health checks. Every `rift ...` command
# keeps working either way. false: `rift` alone prints the help instead.
# RIFT_TUI=true
