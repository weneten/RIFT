# Copy to .env on the home server: cp .env.agent.example .env
# COMPOSE_PROFILES selects the agent service. The container command is agent.
COMPOSE_PROFILES=agent

# Optional: pin the image to a release, e.g. 0.1.0, and check out the matching tag (git checkout v0.1.0).
# Unset uses latest, which follows the main branch. Use the same version on the server and every agent.
# RIFT_VERSION=

# Hostname and port from the invitation. The port is required.
RIFT_SERVER=rift.example.net:8443
RIFT_AGENT_NAME=node1
# Paste the one-time invitation value. deploy/join removes it once the agent is active; an active agent ignores it.
RIFT_ENROLLMENT_TOKEN=

# Optional: ports this agent may open for forwards and VPN grants, e.g. 22/tcp,80,27015-27020/udp. Empty = no limit.
# RIFT_AGENT_ALLOW_PORTS=
# Optional: networks behind this agent that VPN network grants may reach (single hosts as /32). Empty = no LAN access.
# RIFT_AGENT_ALLOW_SUBNETS=192.168.178.0/24
# Optional: offer this host's internet connection as an exit for VPN devices (rift vpn allow DEVICE AGENT exit).
# Devices are masqueraded and cannot reach private networks except those in RIFT_AGENT_ALLOW_SUBNETS. This also
# allows the one UDP port of the exit, whatever RIFT_AGENT_ALLOW_PORTS says. Default false.
# RIFT_AGENT_ALLOW_EXIT=false
