# Copy to .env on the home server: cp .env.agent.example .env
# COMPOSE_PROFILES selects the agent service. The container command is agent.
COMPOSE_PROFILES=agent

# Hostname and port from the invitation. The port is required.
RIFT_SERVER=rift.example.net:8443
RIFT_AGENT_NAME=node1
# Paste the one-time invitation value. Remove this line after the agent is active.
RIFT_ENROLLMENT_TOKEN=

# Optional: ports this agent may open for forwards and VPN grants, e.g. 22/tcp,80,27015-27020/udp. Empty = no limit.
# RIFT_AGENT_ALLOW_PORTS=
# Optional: networks behind this agent that VPN --subnet grants may reach. Empty = no LAN access.
# RIFT_AGENT_ALLOW_SUBNETS=192.168.178.0/24
