# Copy to .env in the repository root. Keep secret values out of source control.
# RIFT_ROLE is server on the VPS and agent on the home host.
RIFT_ROLE=server

# VPS. RIFT_PUBLIC_ENDPOINT is the DNS name or address agents dial, without a port.
# RIFT_PUBLIC_IPS is the address assigned on the VPS NIC. A DNS name is not accepted.
RIFT_PUBLIC_ENDPOINT=rift.example.net
RIFT_PUBLIC_IPS=203.0.113.10

# The agent enrolls against this TLS endpoint (hostname:port is required).
RIFT_SERVER=rift.example.net:8443
RIFT_AGENT_NAME=core
# Paste the one-time invitation value printed by `rift agents add core --ttl 15m`.
# Treat it as a secret and use it only for this enrollment.
RIFT_ENROLLMENT_TOKEN=

# Optional VPS settings.
# RIFT_ENROLLMENT_BIND=0.0.0.0:8443
# RIFT_ENROLLMENT_ENABLED=true
